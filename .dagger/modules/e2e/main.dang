"""
End-to-end checks for the TypeScript SDK module.

Checks are grouped by the SDK surface they cover, one group per file, and share
the assertions in `Asserts` and the fixture paths in `Fixtures` (util.dang).
Each group drives the installed `typescript-sdk` dependency against the fixture
tree under `.dagger/modules/e2e/fixtures`, read either through this repo's own
workspace or — where a check needs to control the caller cwd or the module
layout — through a synthetic workspace built for it.
"""
type E2e {
  """Checks for manifest pins and local dependency paths."""
  manifest: ManifestChecks! { ManifestChecks() }

  """
  Checks for the SDK-level surface: target runtime, templates, and the Go
  helpers' own tests.
  """
  sdk: SdkChecks! {
    SdkChecks
  }

  """
  Checks for which managed modules are in scope from a given cwd.
  """
  discovery: DiscoveryChecks! {
    DiscoveryChecks
  }

  """
  Checks for seeding a scope that has no module yet.
  """
  init: InitChecks! {
    InitChecks
  }

  """
  Checks for module codegen through the scope generator.
  """
  generate: GenerateChecks! {
    GenerateChecks
  }

  """
  Checks for typed client generation.
  """
  client: ClientChecks! {
    ClientChecks
  }
}
