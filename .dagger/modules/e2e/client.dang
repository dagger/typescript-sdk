"""
Checks for typed client generation, the client half of `generateScope`.

A scope gets one self-contained package serving every target it records:
dagger.gen.ts for the core types, one <module>.gen.ts per target, plus
package.json and tsconfig.json. One package rather than one per target, because
the core API is the bulk of a generated client and every target shares it.
"""
type ClientChecks {
  let fixtures: Fixtures! = Fixtures

  """
  dagger/dagger commit whose sdk/typescript builds the @dagger.io/dagger the
  compile check type-checks against. Pinned to a commit (not a branch) so
  Dagger content-addresses the whole SDK build and reuses it across runs — a
  branch re-resolves HEAD every run and rebuilds. Bump to track main.
  """
  let daggerSourceRef: String! = "b82dd645c0a2759cee20b038de3d155ce3860cf6"

  """
  Where a client-only scope's generated package lives, relative to the scope.
  """
  let clientDir(scope: String!): String! {
    scope + "/.dagger/clients"
  }

  """
  Generate the client half of a scope bound to the client-app fixture.
  """
  let generateClients(ws: Workspace!, scope: String!): Changeset! {
    Gen.scope(
      ws,
      scope,
      "",
      isModule: false,
      clients: [ws.moduleSource("/" + fixtures.clientModule)],
    )
  }

  """
  Assert that a changeset holds a complete client package for `scope`.
  """
  let clientPackage(changes: Changeset!, scope: String!): Void {
    let path = clientDir(scope)
    Asserts.generated(changes, path + "/dagger.gen.ts")
    Asserts.generated(changes, path + "/client-app.gen.ts")
    Asserts.generated(changes, path + "/package.json")
    Asserts.generated(changes, path + "/tsconfig.json")
    null
  }

  """
  A scope with one client target should produce a complete package: dagger.gen.ts
  for the core types, one <module>.gen.ts for the target, and the package config
  that makes it installable on its own.
  """
  generateClientCheck(ws: Workspace!): Void @check {
    clientPackage(generateClients(ws, fixtures.clientOutput), fixtures.clientOutput)

    null
  }

  """
  A generated client must type-check. The bindings extend `BaseClient`, which no
  published @dagger.io/dagger exports yet, so build the library from dagger `main`
  and `tsc --noEmit` the generated client against it — catching binding/tsconfig
  bugs that file-presence checks miss.
  """
  generateClientCompilesCheck(ws: Workspace!): Void @check {
    let changes = generateClients(ws, fixtures.clientOutput)
    let generated = changes.layer.directory(clientDir(fixtures.clientOutput))

    let node = container
      .from("node:22-alpine")
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))

    # Build @dagger.io/dagger from source (pinned dagger commit). npm needs
    # --legacy-peer-deps for the SDK's graphql peer range. The pinned tree makes
    # this whole chain cache: after the first build, later runs reuse the layer
    # and the npm cache volume backs the first build's downloads.
    let daggerLib = node
      .withDirectory(
        "/build",
        git("https://github.com/dagger/dagger").commit(daggerSourceRef).tree.directory("sdk/typescript"),
      )
      .withWorkdir("/build")
      .withExec(["npm", "install", "--no-audit", "--no-fund", "--legacy-peer-deps"])
      .withExec(["npm", "run", "build"])
      .directory("/build")

    # Point the client's @dagger.io/dagger at the built lib (npm install of a
    # local path overrides the version pin) and type-check.
    let out = node
      .withDirectory("/dagger-lib", daggerLib)
      .withDirectory("/client", generated)
      .withWorkdir("/client")
      .withExec(["npm", "install", "--no-audit", "--no-fund", "--legacy-peer-deps", "/dagger-lib", "typescript@5.9.3"])
      .withExec(["npx", "--no-install", "tsc", "--noEmit"])
      .stdout

    null
  }

  """
  Regenerating a client whose package.json already points @dagger.io/dagger at a
  local bundle must preserve that dependency (not overwrite it with the engine
  version pin), and the emitted package.json must be pretty-printed.

  Regeneration owns the `*.gen.ts` bindings and nothing else: hand-written files
  in the client package survive, while bindings for a module that has left the
  closure are pruned.
  """
  generateClientRespectsExistingCheck(ws: Workspace!): Void @check {
    let changes = generateClients(ws, fixtures.clientExisting)
    let generatedDir = clientDir(fixtures.clientExisting)

    # The "./sdk" value proves the local ref is preserved; the ": " (space after
    # colon) proves the output is pretty-printed, not a single minified line.
    let pkg = changes.layer.file(generatedDir + "/package.json").contents
    Asserts.stringContains(
      pkg,
      "\"@dagger.io/dagger\": \"./sdk\"",
      "existing local @dagger.io/dagger ref must be preserved and pretty-printed",
    )
    Asserts.stringContains(pkg, "\"name\": \"my-existing-client\"", "existing package name must be preserved")

    # Report what was actually removed: this check has failed on a difference
    # between a local-directory workspace and a git-loaded one, and the paths
    # are the only way to tell which side of the split behaved differently.
    let removed = "removed [" + changes.removedPaths.join(", ") + "]"
    Asserts.assert(
      Asserts.contains(changes.removedPaths, fixtures.clientExisting + "/main.ts") == false,
      "regeneration removed a hand-written file from the scope: " + removed,
    )
    # The scope's own package.json belongs to the user. The generated package is
    # self-contained and installed by hand, so nothing here may touch it.
    Asserts.assert(
      Asserts.contains(changes.modifiedPaths, fixtures.clientExisting + "/package.json") == false,
      "regeneration modified the user's own package.json",
    )
    # Read the resulting workspace, not the changeset's after-tree: that tree
    # holds only what generation touched, so a file surviving untouched is
    # exactly the case it cannot show.
    Asserts.stringContains(
      ws.withChanges(changes).directory("/" + fixtures.clientExisting).file("main.ts").contents,
      "hello from the user's own file",
      "hand-written code in the scope must survive regeneration",
    )
    Asserts.assert(
      Asserts.contains(changes.removedPaths, generatedDir + "/stale-dep.gen.ts"),
      "regeneration should prune bindings for a target that left the scope: " + removed,
    )

    null
  }

  """
  The ownership split must hold whatever the workspace is made of.

  A synthetic workspace is the shape a git-loaded one has, which is how the
  Cloud checks runner loads this repo, and workspace write semantics have
  differed between the two kinds before. Assert the resulting tree rather than
  the changeset's removals: the tree is what the user is left with either way.
  """
  generateClientOnSyntheticWorkspaceCheck(ws: Workspace!): Void @check {
    let synthetic = ws.directory("/").asWorkspace
    let changes = generateClients(synthetic, fixtures.clientExisting)
    let after = synthetic.withChanges(changes)
    let entries = after.directory("/" + clientDir(fixtures.clientExisting)).entries
    let kept = "kept [" + entries.join(", ") + "]"

    Asserts.assert(
      Asserts.contains(after.directory("/" + fixtures.clientExisting).entries, "main.ts"),
      "hand-written code in the scope must survive: " + kept,
    )
    Asserts.assert(
      Asserts.contains(entries, "stale-dep.gen.ts") == false,
      "bindings for a target that left the scope must be pruned: " + kept,
    )
    Asserts.assert(Asserts.contains(entries, "dagger.gen.ts"), "regeneration must write the core bindings: " + kept)

    null
  }

  """
  Removing the last target should take the package with it. `clients` is the
  complete desired set, so an empty one means the scope serves nothing — leaving
  the bindings behind would export an API against a module no longer served.
  """
  removeClientsCheck(ws: Workspace!): Void @check {
    let generated = ws.withChanges(generateClients(ws, fixtures.clientOutput))
    let removed = Gen.scope(generated, fixtures.clientOutput, "", isModule: false)

    Asserts.assert(
      Asserts.contains(removed.removedPaths, clientDir(fixtures.clientOutput) + "/"),
      "dropping the last target should remove the generated package, got: "
        + removed.removedPaths.join(", "),
    )

    null
  }

  """
  A scope serving two targets should get one package: one core file, and one
  bindings file per target. Emitting the core API per target instead would
  duplicate the bulk of the client for every module a scope binds.
  """
  multipleClientsCheck(ws: Workspace!): Void @check {
    let path = clientDir(fixtures.clientOutput)
    let changes = Gen.scope(
      ws,
      fixtures.clientOutput,
      "",
      isModule: false,
      clients: [
        ws.moduleSource("/" + fixtures.clientModule),
        ws.moduleSource("/" + fixtures.generateModule),
      ],
    )

    Asserts.generated(changes, path + "/dagger.gen.ts")
    Asserts.generated(changes, path + "/client-app.gen.ts")
    Asserts.generated(changes, path + "/generate-app.gen.ts")

    # Both targets must be served by the one bootstrap, or the second `dag.<mod>()`
    # resolves against a module nothing installed.
    let core = changes.layer.file(path + "/dagger.gen.ts").contents
    Asserts.stringContains(core, fixtures.clientModule, "the core file should serve the first target")
    Asserts.stringContains(core, fixtures.generateModule, "the core file should serve the second target")

    null
  }
}
