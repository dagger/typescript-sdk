"""
Checks for typed client generation, the client half of `generateScope`.

A standalone client scope renders one npm-installable package per target under
.dagger/clients, beside the vendored library as its own @dagger.io/dagger
package. The client files are the same rendering a module's clients get — each
serves its own module on use — and the user wires them in with
`npm install ./.dagger/clients/<module>`; nothing of the user's is edited.
"""
type ClientChecks {
  let fixtures: Fixtures! = Fixtures

  """
  Where a client-only scope's generated package lives, relative to the scope.
  """
  let clientDir(scope: String!): String! {
    scope + "/.dagger/clients"
  }

  """
  Generate the client half of a scope bound to the client-app fixture.
  """
  let generateClients(ws: Workspace!, scope: String!): Changeset! {
    Gen.scope(
      ws,
      scope,
      "",
      isModule: false,
      clients: [ws.moduleSource("/" + fixtures.clientModule)],
    )
  }

  """
  Assert that a changeset holds a complete client scope for `scope`: the library
  package plus one package per target.
  """
  let clientPackage(changes: Changeset!, scope: String!): Void {
    let path = clientDir(scope)
    Asserts.generated(changes, path + "/dagger/package.json")
    Asserts.generated(changes, path + "/dagger/client.gen.ts")
    Asserts.generated(changes, path + "/dagger/core.js")
    Asserts.generated(changes, path + "/dagger/index.ts")
    Asserts.generated(changes, path + "/client-app/package.json")
    Asserts.generated(changes, path + "/client-app/client-app.gen.ts")
    null
  }

  """
  A scope with one client target should produce the two packages, correctly
  named and linked: the client imports the library by its package name, serves
  its own module on use, and declares the library as a file: dependency so
  installing the client pulls it along.
  """
  generateClientCheck(ws: Workspace!): Void @check {
    let changes = generateClients(ws, fixtures.clientOutput)
    clientPackage(changes, fixtures.clientOutput)

    let path = clientDir(fixtures.clientOutput)
    let tree = changes.after.directory(path)

    let client = tree.file("client-app/client-app.gen.ts").contents
    Asserts.stringContains(client, "from \"@dagger.io/dagger\"", "a client should import the library as a package")
    Asserts.stringContains(client, "asModule().serve()", "a client should serve its own module on use")

    let clientPkg = tree.file("client-app/package.json").contents
    Asserts.stringContains(clientPkg, "\"name\": \"@dagger.io/client-app\"", "a client package is named for its module")
    Asserts.stringContains(clientPkg, "\"@dagger.io/dagger\": \"file:../dagger\"", "a client package links the library beside it")

    let libPkg = tree.file("dagger/package.json").contents
    Asserts.stringContains(libPkg, "\"name\": \"@dagger.io/dagger\"", "the library package carries the SDK's name")
    Asserts.stringContains(libPkg, "\"./telemetry\": \"./telemetry.ts\"", "the library package exposes telemetry as a sub-path")

    null
  }

  """
  The generated packages must install and type-check the way a user consumes
  them: `npm install ./.dagger/clients/<module>` in a project above the
  generated tree, then a plain nodenext tsc with no path aliases — package
  resolution alone. This is the installability contract, checked end to end.
  """
  generateClientCompilesCheck(ws: Workspace!): Void @check {
    let changes = generateClients(ws, fixtures.clientOutput)
    let generated = changes.layer.directory(clientDir(fixtures.clientOutput))

    let mainTs = "import { connection, dag } from \"@dagger.io/dagger\"\n" +
      "import { clientApp } from \"@dagger.io/client-app\"\n" +
      "export async function run(): Promise<string> {\n" +
      "  let out = \"\"\n" +
      "  await connection(async () => {\n" +
      "    void dag\n" +
      "    out = await clientApp().hello(\"world\")\n" +
      "  })\n" +
      "  return out\n" +
      "}\n"

    let out = container
      .from("node:22-alpine")
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withDirectory("/app/.dagger/clients", generated)
      .withWorkdir("/app")
      .withNewFile("/app/package.json", "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\"\n}")
      .withNewFile("/app/tsconfig.json", "{\n  \"compilerOptions\": {\n    \"module\": \"nodenext\",\n    \"target\": \"esnext\",\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"types\": []\n  },\n  \"include\": [\"main.ts\"]\n}")
      .withNewFile("/app/main.ts", mainTs)
      .withExec(["npm", "install", "--no-audit", "--no-fund", "./.dagger/clients/client-app", "./.dagger/clients/dagger", "typescript@5.9.3"])
      .withExec(["npx", "--no-install", "tsc", "--noEmit", "-p", "tsconfig.json"])
      .stdout

    null
  }

  """
  Regeneration owns the generated files and nothing else: a hand-written file in
  the client scope survives, the user's own scope package.json is never touched,
  and a client for a target that left the scope is pruned.
  """
  generateClientRespectsExistingCheck(ws: Workspace!): Void @check {
    let changes = generateClients(ws, fixtures.clientExisting)
    let generatedDir = clientDir(fixtures.clientExisting)

    # Report what was actually removed: this check has failed on a difference
    # between a local-directory workspace and a git-loaded one, and the paths
    # are the only way to tell which side of the split behaved differently.
    let removed = "removed [" + changes.removedPaths.join(", ") + "]"
    Asserts.assert(
      Asserts.contains(changes.removedPaths, fixtures.clientExisting + "/main.ts") == false,
      "regeneration removed a hand-written file from the scope: " + removed,
    )
    # The scope's own package.json belongs to the user. The generated package is
    # self-contained and installed by hand, so nothing here may touch it.
    Asserts.assert(
      Asserts.contains(changes.modifiedPaths, fixtures.clientExisting + "/package.json") == false,
      "regeneration modified the user's own package.json",
    )
    # Read the resulting workspace, not the changeset's after-tree: that tree
    # holds only what generation touched, so a file surviving untouched is
    # exactly the case it cannot show.
    Asserts.stringContains(
      ws.withChanges(changes).directory("/" + fixtures.clientExisting).file("main.ts").contents,
      "hello from the user's own file",
      "hand-written code in the scope must survive regeneration",
    )
    Asserts.assert(
      Asserts.contains(changes.removedPaths, generatedDir + "/stale-dep.gen.ts"),
      "regeneration should prune bindings for a target that left the scope: " + removed,
    )

    null
  }

  """
  The ownership split must hold whatever the workspace is made of.

  A synthetic workspace is the shape a git-loaded one has, which is how the
  Cloud checks runner loads this repo, and workspace write semantics have
  differed between the two kinds before. Assert the resulting tree rather than
  the changeset's removals: the tree is what the user is left with either way.
  """
  generateClientOnSyntheticWorkspaceCheck(ws: Workspace!): Void @check {
    let synthetic = ws.directory("/").asWorkspace
    let changes = generateClients(synthetic, fixtures.clientExisting)
    let after = synthetic.withChanges(changes)
    let entries = after.directory("/" + clientDir(fixtures.clientExisting)).entries
    let kept = "kept [" + entries.join(", ") + "]"

    Asserts.assert(
      Asserts.contains(after.directory("/" + fixtures.clientExisting).entries, "main.ts"),
      "hand-written code in the scope must survive: " + kept,
    )
    Asserts.assert(
      Asserts.contains(entries, "stale-dep.gen.ts") == false,
      "bindings for a target that left the scope must be pruned: " + kept,
    )
    Asserts.assert(Asserts.contains(entries, "dagger"), "regeneration must write the library package: " + kept)

    null
  }

  """
  Removing the last target should take the package with it. `clients` is the
  complete desired set, so an empty one means the scope serves nothing — leaving
  the bindings behind would export an API against a module no longer served.
  """
  removeClientsCheck(ws: Workspace!): Void @check {
    let generated = ws.withChanges(generateClients(ws, fixtures.clientOutput))
    let removed = Gen.scope(generated, fixtures.clientOutput, "", isModule: false)

    Asserts.assert(
      Asserts.contains(removed.removedPaths, clientDir(fixtures.clientOutput) + "/"),
      "dropping the last target should remove the generated package, got: "
        + removed.removedPaths.join(", "),
    )

    null
  }

  """
  A module scope's clients live in clients/, apart from the library, and the
  module's own source reaches each through its @dagger.io/<module>
  specifier.

  A client added inside a module lands in clients/<target>.gen.ts, beside the
  module's own client and the loader; the library (sdk/) stays core-only. The
  module's source reaches the target through the tsconfig alias, so a client
  added inside a module is usable from it straight away.
  """
  moduleScopeClientBindingsCheck(ws: Workspace!): Void @check {
    let scope = fixtures.depLibModule
    let changes = Gen.scope(
      ws,
      scope,
      "gendep",
      clients: [ws.moduleSource("/" + fixtures.clientModule)],
    )

    # The target's client lands under clients/, not in the library.
    Asserts.generated(changes, scope + "/clients/client-app.gen.ts")
    Asserts.notGenerated(
      changes,
      scope + "/sdk/client-app.gen.ts",
      "a module client belongs in clients/, not in the library",
    )

    let tree = changes.after.directory(scope)

    # Its file is its own client — root Client, dag, entrypoint functions —
    # reaching the library through the package specifier, since it no longer
    # sits beside the bundle.
    let targetClient = tree.file("clients/client-app.gen.ts").contents
    Asserts.stringContains(
      targetClient,
      "from \"@dagger.io/dagger\"",
      "a module client should import the library as a package",
    )
    Asserts.stringContains(
      targetClient,
      "export const dag = new Client(",
      "a target's client should carry its own dag",
    )

    # The library stays core-only: no target file, no re-export of one.
    Asserts.assert(
      tree.file("sdk/client.gen.ts").contents.contains("client-app.gen.js") == false,
      "the library's core bindings should not reference a module client",
    )
    Asserts.generated(changes, scope + "/clients/loader.gen.ts")
    Asserts.stringContains(
      tree.file("tsconfig.json").contents,
      "\"@dagger.io/client-app\"",
      "the module's tsconfig should alias each generated module client",
    )

    null
  }

  """
  A client scope vendors the whole @dagger.io/dagger library as a package, so
  it resolves offline with no remote dependency — the point of vendoring it.
  """
  clientVendorsLibraryCheck(ws: Workspace!): Void @check {
    let path = clientDir(fixtures.clientOutput)
    let changes = generateClients(ws, fixtures.clientOutput)

    ["dagger/core.js", "dagger/core.d.ts", "dagger/index.ts", "dagger/telemetry.ts", "dagger/client.gen.ts", "dagger/package.json"].each { file =>
      Asserts.generated(changes, path + "/" + file)
    }

    null
  }

  """
  A scope serving two targets gets one shared library package and one package
  per target, each serving its own module — no per-target duplication of the
  core API, no central serve, and each package linking the sibling it might
  reference.
  """
  multipleClientsCheck(ws: Workspace!): Void @check {
    let path = clientDir(fixtures.clientOutput)
    let changes = Gen.scope(
      ws,
      fixtures.clientOutput,
      "",
      isModule: false,
      clients: [
        ws.moduleSource("/" + fixtures.clientModule),
        ws.moduleSource("/" + fixtures.generateModule),
      ],
    )

    # One shared library package, plus one package per target.
    Asserts.generated(changes, path + "/dagger/client.gen.ts")
    Asserts.generated(changes, path + "/client-app/client-app.gen.ts")
    Asserts.generated(changes, path + "/generate-app/generate-app.gen.ts")

    # Each client serves its own module, in its own file — not a central
    # bootstrap in the core — and links its sibling as a file: dependency.
    let tree = changes.after.directory(path)
    Asserts.stringContains(tree.file("client-app/client-app.gen.ts").contents, "asModule().serve()", "the first target's client should serve its own module")
    Asserts.stringContains(tree.file("generate-app/generate-app.gen.ts").contents, "asModule().serve()", "the second target's client should serve its own module")
    Asserts.stringContains(
      tree.file("client-app/package.json").contents,
      "\"@dagger.io/generate-app\": \"file:../generate-app\"",
      "a client package should link its siblings",
    )

    null
  }
}
