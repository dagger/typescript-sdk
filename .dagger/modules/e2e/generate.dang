"""
Checks for module codegen — `Mod.generate` for one module and
`typescriptSdk.generateAllModule` for everything in scope.

Both stage a module's local dependency closure before generating it, so a
module's own codegen always sees up-to-date bindings for the modules it imports.
"""
type GenerateChecks {
  let fixtures: Fixtures! = Fixtures

  """
  Generating an existing module should produce generated files rooted at that
  module without touching unrelated paths.
  """
  generateCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.mod(ws, path: fixtures.generateModule).generate(ws)

    Asserts.generated(changes, fixtures.generateModule + "/sdk/index.ts")

    null
  }

  """
  Generating a module through this SDK and through the engine should produce the
  same tree.

  The gate the cutover is staged behind. `generateModuleLocal` generates through
  this SDK while `Mod.generate` still delegates to the engine, so the same
  fixture can be produced both ways and diffed — and until the two agree there
  is no case for switching the routing over.

  Scoped to the generated files rather than the whole module directory, because
  the two changesets are not the same kind of tree: ours layers onto the
  module's existing files, so `after` also holds its src/ and lockfile, while
  the engine's carries only what it staged. Comparing directories would compare
  that difference, not the generators.

  The two files left out are the bundle's, not the generator's: `sdk/core.js`
  and `sdk/core.d.ts` are bundler and compiler output, and ours is built from
  the vendored lockfile where the engine's is built from whatever it resolves.
  core.js differs in size; core.d.ts differs in the order of a union's members,
  which is the tell that the two builds ran different TypeScript versions. Ours
  being reproducible is worth more than ours matching an unpinned build, so this
  asserts nothing about them.

  Everything the generator itself produces has to match byte for byte: the
  bindings, the hand-written wrappers, the entrypoint, and both config files.
  """
  localMatchesEngineCheck(ws: Workspace!): Void @check {
    let path = fixtures.generateModule
    let bundleFiles = ["core.js", "core.d.ts"]

    let ours = typescriptSdk.generateModuleLocal(ws, path).after.directory(path)
    let engine = ws.moduleSource("/" + path).generate(ws).changes(ws).after.directory(path)

    Asserts.assert(
      ours.directory("sdk").withoutFiles(bundleFiles).digest ==
        engine.directory("sdk").withoutFiles(bundleFiles).digest,
      "this SDK and the engine should generate the same sdk/ bindings and wrappers",
    )

    ["__dagger.entrypoint.ts", "package.json", "tsconfig.json"].each { name =>
      Asserts.assert(
        ours.file(name).digest == engine.file(name).digest,
        "this SDK and the engine should generate the same " + name,
      )
    }

    null
  }

  """
  Generating a module with a local dependency must resolve that dependency and
  emit its typed bindings alongside the module's own — otherwise the module's
  source cannot import it and the generated tree does not type-check.

  Both sides here are dagger-module.toml modules, the CLI 1.0 format: before
  dagger-module.toml dir deps were included in the generated context this failed
  with "dir module source does not contain a dagger config file".
  """
  generateDependencyCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.mod(ws, path: fixtures.depAppModule).generate(ws)

    Asserts.generated(changes, fixtures.depAppModule + "/sdk/index.ts")
    Asserts.generated(changes, fixtures.depAppModule + "/sdk/gendep.gen.ts")

    # Generating the dependent stages its dependency's codegen only to feed its
    # own; that staging is ephemeral and must not leak into the changeset.
    Asserts.notAdded(
      changes,
      fixtures.depLibModule + "/sdk/index.ts",
      "generating a dependent should not also stage its dependency's own files",
    )

    null
  }

  """
  Generating everything should cover the whole managed set — including both ends
  of a local dependency edge — and leave every module out of scope alone.

  The dependency ordering is the interesting part: app and dep are each managed
  in their own right, so generate-all produces app's bindings (which embed dep)
  and dep's own bindings, and the two changesets have to merge cleanly rather
  than conflict over the files the closure staging touched.
  """
  generateAllCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.generateAllModule(ws)

    Asserts.generated(changes, fixtures.generateModule + "/sdk/index.ts")

    # Both ends of the dependency edge, plus the dependency's bindings inside
    # the dependent.
    Asserts.generated(changes, fixtures.depAppModule + "/sdk/index.ts")
    Asserts.generated(changes, fixtures.depAppModule + "/sdk/gendep.gen.ts")
    Asserts.generated(changes, fixtures.depLibModule + "/sdk/index.ts")

    # Skip-marked and unmanaged modules stay untouched.
    Asserts.notAdded(
      changes,
      fixtures.lookupModule + "/sdk/index.ts",
      "generate-all generated a lookup fixture that should be skipped",
    )
    Asserts.notAdded(
      changes,
      fixtures.depsModule + "/sdk/index.ts",
      "generate-all generated dependency fixtures that should be skipped",
    )
    Asserts.notAdded(
      changes,
      fixtures.skipModule + "/sdk/index.ts",
      "generate-all generated a skipped module",
    )
    Asserts.notAdded(
      changes,
      fixtures.managedTomlModule + "/sdk/index.ts",
      "generate-all generated a skipped dagger-module.toml module",
    )
    Asserts.notAdded(
      changes,
      fixtures.parentSourceCode + "/sdk/index.ts",
      "generate-all generated a skipped relocated-source module",
    )
    Asserts.notAdded(
      changes,
      fixtures.nonTsModule + "/sdk/index.ts",
      "generate-all generated a non-TypeScript SDK module",
    )

    null
  }

  """
  Generate-all is scoped by the same cwd-anchored discovery as modules(), so
  running it where this SDK manages nothing does nothing — it must not fall back
  to the whole workspace.

  Only the empty direction is checked here. Codegen needs a client-backed
  workspace (generateLocalDependencies fails with "workspace has no client ID"
  on a re-anchored snapshot), so generating from a subdirectory for real cannot
  run as a check. Which modules a cwd selects is covered by
  `discovery:modules-cwd-check`, and measuring the result from the cwd belongs
  to the engine, which owns it past the changeset cwd cutover.
  """
  generateAllScopeCheck(ws: Workspace!): Void @check {
    let outside = fixtures.discoverySnapshot(
      ws,
      fixtures.root + "/init-existing",
      extra: [fixtures.root + "/init-existing/**"],
    )
    let changes = typescriptSdk.generateAllModule(outside)

    Asserts.assert(
      changes.isEmpty,
      "generate-all outside every managed module should produce no changes",
    )

    null
  }

  """
  A skip marker above a module should make generate return an empty changeset.
  """
  skipGenerateCheck(ws: Workspace!): Void @check {
    let mod = typescriptSdk.mod(ws, path: fixtures.skipModule)
    let changes = mod.generate(ws)

    Asserts.assert(mod.skipGenerate(ws), "skip marker was not detected")
    Asserts.assert(changes.isEmpty, "generate returned changes for a skipped module")

    null
  }
}
