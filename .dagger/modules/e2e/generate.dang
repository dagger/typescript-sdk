"""
Checks for module codegen through `generateScope`, the entry point the engine drives.

The SDK does not stage a dependency closure. The engine orders scopes so a
module is generated before anything that holds a client for it, and threads each
result into the next, so a module's codegen already sees current bindings.
"""
type GenerateChecks {
  let fixtures: Fixtures! = Fixtures

  """
  Generating an existing scope should produce generated files rooted at that
  module without touching unrelated paths.
  """
  generateCheck(ws: Workspace!): Void @check {
    let changes = Gen.module(ws, fixtures.depLibModule, "gendep")

    Asserts.generated(changes, fixtures.depLibModule + "/sdk/index.ts")

    null
  }

  """
  A CLI 1.0 module is generated by this SDK, and what it writes has to satisfy
  the engine runtime by itself: that runtime does no codegen for a
  dagger-module.toml module, it mounts sdk/ as @dagger.io/dagger and runs the
  committed entrypoint.

  So this asserts the whole contract rather than a single marker file — the
  bundled library the bindings import, the bindings themselves, the dispatch
  entrypoint, and the config the runtime reads. A missing piece here is a module
  that fails to load at `dagger call` time, long after generate.
  """
  generateWorkspaceModuleCheck(ws: Workspace!): Void @check {
    let path = fixtures.depAppModule
    let staged = Gen.withDependency(ws)
    let changes = Gen.module(staged, path, "generate-deps-app")
    # The module as it stands once the changes are applied, not the changeset's
    # own after side. Generation writes only the files it changes, so a file it
    # correctly left alone — this fixture's package.json and tsconfig.json — is
    # not in the changeset at all, and reading one out of it fails outright.
    let tree = staged.withChanges(changes).directory("/" + path)

    Asserts.generated(changes, path + "/sdk/client.gen.ts")
    Asserts.generated(changes, path + "/sdk/core.js")
    Asserts.generated(changes, path + "/sdk/core.d.ts")
    Asserts.generated(changes, path + "/sdk/index.ts")
    Asserts.generated(changes, path + "/sdk/telemetry.ts")
    Asserts.generated(changes, path + "/__dagger.entrypoint.ts")

    # The bindings must reach the runtime through the bundle sitting beside
    # them, not through the npm package: sdk/ *is* @dagger.io/dagger here.
    Asserts.stringContains(
      tree.file("sdk/client.gen.ts").contents,
      "from \"./core.js\"",
      "module bindings should import the bundled runtime",
    )

    # The entrypoint dispatches by importing the user's classes from where they
    # were declared, which only the source scan knows.
    Asserts.stringContains(
      tree.file("__dagger.entrypoint.ts").contents,
      "from \"./src/index\"",
      "entrypoint should import the module's own source",
    )

    # This fixture arrives already pinned, so the pin only proves generation
    # preserved it. That generation *writes* one is generateTypescriptPinCheck.
    Asserts.stringContains(
      tree.file("package.json").contents,
      "\"typescript\"",
      "package.json should keep the module's typescript pin",
    )
    Asserts.stringContains(
      tree.file("tsconfig.json").contents,
      "./sdk/index.ts",
      "tsconfig should alias @dagger.io/dagger to the generated sdk",
    )

    null
  }

  """
  Generating a module that has not pinned typescript should add the pin.

  Run against the dependency fixture, whose package.json carries nothing but
  `type: module` — the shape a module has before its first generate. That is the
  only way to tell writing from preserving: a fixture that arrives pinned goes
  on passing after generation stops writing the pin. The cost of losing it is
  silent — the runtime mounts its prebuilt compiler
  only when the version matches its default, so an unpinned module installs
  typescript on every single call.
  """
  generateTypescriptPinCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let changes = Gen.module(ws, path, "gendep")

    Asserts.stringNotContains(
      ws.directory("/" + path).file("package.json").contents,
      "typescript",
      "fixture must start unpinned for this check to mean anything",
    )
    Asserts.stringContains(
      changes.after.directory(path).file("package.json").contents,
      "\"typescript\"",
      "generation should pin typescript for a module that has not",
    )

    null
  }

  """
  Regenerating should remove bindings for dependencies the module no longer has.

  Layering the generated tree over the existing one is what keeps a module's own
  source and config out of the diff, but it also leaves behind any file we no
  longer generate: drop a dependency and its `<dep>.gen.ts` stays inside sdk/,
  exporting an API against a module that is no longer served. A default `tsc`
  rejects it.

  Staged rather than fixtured because clients/ is gitignored in every module, so
  there is no committed stale file to start from — the check plants one and
  asserts regeneration takes it away.
  """
  generatePrunesStaleBindingsCheck(ws: Workspace!): Void @check {
    let path = fixtures.depAppModule
    let stale = path + "/sdk/departed.gen.ts"

    let dirty = Gen.withDependency(ws).withNewFile("/" + stale, "export const gone = true\n")
    let changes = Gen.module(dirty, path, "generate-deps-app")

    Asserts.generated(changes, path + "/sdk/gendep.gen.ts")
    Asserts.assert(
      Asserts.contains(changes.removedPaths, stale),
      "regeneration should remove bindings for a dependency that is gone, got removed [" +
        changes.removedPaths.join(", ") + "]",
    )

    null
  }

  """
  Regenerating a `[runtime]` module should take away the entrypoint files an
  earlier generation left behind.

  The `legacyRuntime` setting picks a loading path whole, and coming onto it
  stops the writing but not the files: __dagger.dispatch.ts and
  entrypoint/main.dang stay on disk beside the dispatcher the runtime really
  execs, describing a call recipe nothing reads. Staged rather than fixtured for
  the same reason as the stale bindings above — nothing generated today has
  either file to start from.
  """
  generatePrunesEntrypointCheck(ws: Workspace!): Void @check {
    let path = fixtures.depAppModule
    let dispatcher = path + "/__dagger.dispatch.ts"

    let dirty = Gen.withDependency(ws)
      .withNewFile("/" + dispatcher, "export const gone = true\n")
      .withNewFile("/" + path + "/entrypoint/main.dang", "type Entrypoint {}\n")
    let changes = Gen.module(dirty, path, "generate-deps-app")
    let removed = ", got removed [" + changes.removedPaths.join(", ") + "]"

    Asserts.assert(
      Asserts.contains(changes.removedPaths, dispatcher),
      "regeneration should remove the entrypoint's dispatcher from a [runtime] module" + removed,
    )
    Asserts.assert(
      Asserts.contains(changes.removedPaths, path + "/entrypoint/"),
      "regeneration should remove the Dang entrypoint from a [runtime] module" + removed,
    )

    null
  }

  """
  Turning `legacyRuntime` back on moves an entrypoint module onto a `[runtime]`,
  the same way turning it off moved it the other way.

  This is the flip a user on a released engine makes: a fresh module declares
  an `[entrypoint]`, and the `[runtime]` layout is the one every released engine
  loads. Generating on with the entrypoint manifest left in place failed twice
  over, neither error naming the setting — the engine resolves no `source` out
  of an entrypoint manifest, so the module's files were looked for at the
  workspace root (`lstat <root>/src: no such file or directory`), and with a
  client recorded the builder refused the dependency first (`legacy runtime is
  required when legacy fields are set`).

  Asserted on the whole move rather than the manifest alone: a manifest saying
  `[runtime]` beside the entrypoint's files is a module that loads nothing. And
  on a third generation writing nothing, which is what says the flipped module
  loaded during the flip — a `[runtime]` module's self client only renders when
  it does, so a flip that left it unloadable would write the client next time.
  """
  generateFlipsBackToRuntimeCheck(ws: Workspace!): Void @check {
    let path = fixtures.out + "/flip-back"
    let name = "flip-back"
    let entrypoint = ws.withChanges(Gen.scope(ws, path, name, template: "empty", legacyRuntime: false))
    Asserts.assert(
      entrypoint.directory("/" + path).exists("clients/dagger"),
      "the scope must start as a packaged entrypoint module for the flip to mean anything",
    )

    let changes = Gen.scope(entrypoint, path, name, legacyRuntime: true)
    let tree = entrypoint.withChanges(changes).directory("/" + path)
    let manifest = tree.file("dagger-module.toml").contents

    Asserts.stringContains(manifest, "[runtime]", "flipping back did not write the runtime table")
    Asserts.stringContains(manifest, "source = \"typescript\"", "the runtime should be the builtin typescript one")
    Asserts.stringContains(
      manifest,
      "engineVersion = \"v" + typescriptSdk.targetEngineVersion + "\"",
      "flipping back should pin the engine release this SDK ships for",
    )
    Asserts.stringNotContains(manifest, "[entrypoint]", "a [runtime] module should not declare an entrypoint")

    Asserts.generated(changes, path + "/__dagger.entrypoint.ts")
    Asserts.generated(changes, path + "/sdk/client.gen.ts")

    # The resulting tree rather than the changeset's removals, which is what the
    # user is left with whichever way the workspace was loaded.
    let kept = ", kept [" + tree.entries.join(", ") + "]"
    Asserts.assert(tree.exists("__dagger.dispatch.ts") == false, "the entrypoint's dispatcher should go with the flip" + kept)
    Asserts.assert(tree.exists("entrypoint") == false, "the Dang entrypoint should go with the flip" + kept)
    Asserts.assert(tree.exists("clients") == false, "the packaged clients/ should go with the flip" + kept)
    Asserts.stringContains(
      tree.file("tsconfig.json").contents,
      "./sdk/index.ts",
      "tsconfig should alias @dagger.io/dagger to the embedded sdk again",
    )
    Asserts.stringNotContains(
      tree.file("package.json").contents,
      "file:./clients/",
      "package.json should not link packages the flip removed",
    )

    let again = Gen.scope(entrypoint.withChanges(changes), path, name, legacyRuntime: true)
    Asserts.assert(
      again.isEmpty,
      "regenerating a module flipped back should write nothing, got added [" +
        again.addedPaths.join(", ") + "], modified [" + again.modifiedPaths.join(", ") +
        "], removed [" + again.removedPaths.join(", ") + "]",
    )

    null
  }

  """
  The same move for a module with a recorded client, the half that failed
  first: the dependency a client becomes has nowhere to go in an entrypoint
  manifest. On the fresh `[runtime]` manifest it lands as a `[[dependencies]]`
  entry, its bindings as sdk/<target>.gen.ts — the embedded layout's place for a
  client — and the file: link the packaged layout put in package.json goes with
  the package it pointed at.
  """
  generateFlipsBackWithClientCheck(ws: Workspace!): Void @check {
    let path = fixtures.out + "/flip-back-client"
    let name = "flip-back-client"
    let clients = [ws.moduleSource("/" + fixtures.clientModule)]
    let entrypoint = ws.withChanges(
      Gen.scope(ws, path, name, template: "empty", legacyRuntime: false, clients: clients),
    )
    Asserts.assert(
      entrypoint.directory("/" + path).exists("clients/client-app"),
      "the scope must start with a packaged client for the flip to mean anything",
    )

    let changes = Gen.scope(entrypoint, path, name, legacyRuntime: true, clients: clients)
    let tree = entrypoint.withChanges(changes).directory("/" + path)
    let manifest = tree.file("dagger-module.toml").contents

    Asserts.stringContains(manifest, "[runtime]", "flipping back did not write the runtime table")
    Asserts.stringContains(manifest, "[[dependencies]]", "the recorded client should come back as a dependency")
    Asserts.stringContains(manifest, "name = \"client-app\"", "the dependency should carry the target's name")
    Asserts.generated(changes, path + "/sdk/client-app.gen.ts")
    Asserts.assert(
      tree.exists("clients") == false,
      "the packaged clients/ should go with the flip, kept [" + tree.entries.join(", ") + "]",
    )
    Asserts.stringContains(
      tree.file("tsconfig.json").contents,
      "\"./sdk/client-app.gen.ts\"",
      "the module's tsconfig should alias the client into sdk/ again",
    )
    Asserts.stringNotContains(
      tree.file("package.json").contents,
      "\"@dagger.io/client-app\"",
      "package.json should not link the client package the flip removed",
    )

    null
  }

  """
  An entrypoint module's call recipe should install the module's own
  dependencies, with the package manager the module actually uses.

  Under a `[runtime]` the engine installs them before it runs anything. Under an
  entrypoint nothing does — the recipe is ours — so a module that imports any
  package at all fails on its first call with a module-resolution error from
  inside a container, several layers from the cause.

  Which manager is not a detail: a lockfile is the only thing that says so, and
  detection happens once here rather than at call time, the same rule that
  governs the image and the mount layout.
  """
  entrypointInstallsDependenciesCheck(ws: Workspace!): Void @check {
    let yarnScope = Fixtures.out + "/entrypoint-install-yarn"
    let npmScope = Fixtures.out + "/entrypoint-install-npm"
    let bunScope = Fixtures.out + "/entrypoint-install-bun"

    # A fresh Node module commits no lockfile, which is the case yarn is the
    # fallback for.
    let yarn = entrypointRecipe(ws, yarnScope, "entrypoint-install-yarn")
    Asserts.stringContains(
      yarn, "[\"yarn\", \"install\", \"--prod\"]",
      "a Node module with no lockfile should install with yarn",
    )
    Asserts.stringContains(
      yarn, "withMountedDirectory(\"node_modules\", dependencies(workspace))",
      "the installed dependencies should reach the call",
    )

    # A committed package-lock.json moves it to npm, the same signal the engine
    # reads.
    let npm = entrypointRecipe(
      ws.withNewFile("/" + npmScope + "/package-lock.json", "{}\n"),
      npmScope,
      "entrypoint-install-npm",
    )
    Asserts.stringContains(
      npm, "[\"npm\", \"install\", \"--omit=dev\"]",
      "a committed package-lock.json should install with npm",
    )

    # Bun ships its own, and a bun lockfile is what selects the Bun runtime.
    let bun = entrypointRecipe(
      ws.withNewFile("/" + bunScope + "/bun.lock", ""),
      bunScope,
      "entrypoint-install-bun",
    )
    Asserts.stringContains(
      bun, "[\"bun\", \"install\"",
      "a Bun module should install with bun",
    )

    null
  }

  """
  An entrypoint module's call recipe should raise what a function threw, with
  its message, rather than report the exec's exit code.

  The dispatcher runs in a container, so a thrown error used to leave it as a
  nonzero exit and reach the caller as "exit code: 1", the message visible only
  in the exec log — where the builtin runtime's returnError gave them the
  message itself. The dispatcher now replies with the error as data and the
  recipe raises it, which is what keeps the two loading paths reporting the
  same thing. This pins the recipe; the runtimes module runs one for real.
  """
  entrypointReportsErrorsCheck(ws: Workspace!): Void @check {
    let recipe = entrypointRecipe(ws, Fixtures.out + "/entrypoint-errors", "entrypoint-errors")

    Asserts.stringContains(
      recipe, ") :: DispatchReply!",
      "the recipe should decode the dispatcher's reply",
    )
    Asserts.stringContains(
      recipe, "raise failure.message",
      "the recipe should raise a thrown error's message as the function's error",
    )
    Asserts.stringNotContains(
      recipe, ".stdout :: JSON!",
      "the recipe should not take stdout as the result as it is",
    )

    null
  }

  """
  The Dang program a generated entrypoint scope comes out with.
  """
  let entrypointRecipe(ws: Workspace!, scope: String!, name: String!): String! {
    typescriptSdk(legacyRuntime: false, template: "empty", skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(scope), isModule: true, name: name, clients: [])
      .file("entrypoint/main.dang")
      .contents
  }

  """
  A generated module should carry the bundle this SDK ships, not one built
  somewhere else.

  Provenance is invisible in the generated tree otherwise — every path produces
  the same file names — so a regression that reached a different library would
  leave every other check passing while modules drifted from the runtime this
  SDK is paired with.
  """
  generateBundleProvenanceCheck(ws: Workspace!): Void @check {
    let ours = Gen.module(Gen.withDependency(ws), fixtures.depAppModule, "generate-deps-app")
      .after.directory(fixtures.depAppModule).file("sdk/core.js").digest

    Asserts.assert(
      ours == typescriptSdk.libraryBundleFile("core.js").digest,
      "a generated module should carry the bundle this SDK ships",
    )

    null
  }

  """
  A Deno module gets the same bindings, bundle and entrypoint as any other —
  only its config differs, because Deno resolves imports through deno.json
  rather than node_modules plus tsconfig paths.

  The failure this guards against is generating a Deno module as if it were a
  Node one: the tree would look complete while the runtime had no way to
  resolve @dagger.io/dagger at all.
  """
  generateDenoModuleCheck(ws: Workspace!): Void @check {
    let path = fixtures.denoModule
    let changes = Gen.module(ws, path, "generate-deno-app")
    let tree = changes.after.directory(path)

    Asserts.generated(changes, path + "/sdk/client.gen.ts")
    Asserts.generated(changes, path + "/__dagger.entrypoint.ts")
    Asserts.generated(changes, path + "/deno.json")

    Asserts.notAdded(
      changes,
      path + "/package.json",
      "a Deno module should not be given a package.json",
    )
    Asserts.notAdded(
      changes,
      path + "/tsconfig.json",
      "a Deno module resolves through deno.json, not tsconfig paths",
    )

    let denoConfig = tree.file("deno.json").contents
    Asserts.stringContains(
      denoConfig,
      "./sdk/index.ts",
      "deno.json should import @dagger.io/dagger from the generated sdk",
    )
    Asserts.stringContains(
      denoConfig,
      "experimentalDecorators",
      "deno.json should enable the decorators modules are written with",
    )
    Asserts.stringContains(
      denoConfig,
      "\"dev\"",
      "generation should preserve the user's own deno.json entries",
    )

    null
  }

  """
  Generating a module with a local dependency must resolve that dependency and
  emit its typed bindings alongside the module's own — otherwise the module's
  source cannot import it and the generated tree does not type-check.

  Both sides here are dagger-module.toml modules, the CLI 1.0 format: before
  dagger-module.toml dir deps were included in the generated context this failed
  with "dir module source does not contain a dagger config file".
  """
  generateDependencyCheck(ws: Workspace!): Void @check {
    let staged = Gen.withDependency(ws)
    let changes = Gen.module(staged, fixtures.depAppModule, "generate-deps-app")

    Asserts.generated(changes, fixtures.depAppModule + "/sdk/index.ts")
    Asserts.generated(changes, fixtures.depAppModule + "/sdk/gendep.gen.ts")

    # Addressing one module generates that module and nothing else: the
    # dependency's own files are already there, and regenerating them here would
    # write a second module into the diff the caller asked for.
    Asserts.notAdded(
      changes,
      fixtures.depLibModule + "/sdk/index.ts",
      "generating a dependent should not also write its dependency's own files",
    )

    null
  }

  """
  A marked tree should generate nothing.

  The marker lets a scope stay recorded while `dagger generate` writes nothing into it. Found
  with findUp, so one file covers everything beneath it; the fixtures rely on
  that, and so does any repo that vendors modules it does not want regenerated.

  Uses the default marker name rather than Gen's opt-out, which is what every
  other check here passes.
  """
  skipGenerateCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk
      .generateScope(
        ws.withWorkdir(fixtures.depLibModule),
        isModule: true,
        name: "gendep",
        clients: [],
      )
      .withWorkdir(".")
      .changes(ws.withWorkdir("."))

    Asserts.assert(
      changes.isEmpty,
      "a scope under the skip marker should generate nothing, got: " + changes.addedPaths.join(", "),
    )

    null
  }

  """
  A module's bindings should carry its own API, so it can call itself.

  The schema a module's bindings come from is core plus its dependencies: at
  generation time the module is defined by source that has not been compiled, so
  its own API is not in it. Reading the schema that does carry it means loading
  the module, which needs the bindings — so this is generated in a second pass,
  and the check is that the pass happens at all.
  """
  generateSelfCallCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let changes = Gen.module(ws, path, "gendep")
    let tree = changes.after.directory(path)

    # Its own client file under clients/, like any other module's, reached from
    # the module's source through its own @dagger.io/gendep specifier.
    Asserts.generated(changes, path + "/sdk/gendep.gen.ts")
    let selfClient = tree.file("sdk/gendep.gen.ts").contents
    Asserts.stringContains(
      selfClient,
      "export const dag = new Client(",
      "a module's own API should render as its own client",
    )
    Asserts.stringContains(
      selfClient,
      "gendep()",
      "the self accessor should be camelCase like every other member",
    )
    Asserts.stringContains(
      tree.file("tsconfig.json").contents,
      "\"@dagger.io/gendep\"",
      "the second pass should alias the module's own client",
    )

    # The self client serves the module before its first query, which is what
    # makes a self call resolve: the session a call is dispatched into carries
    # only the module's dependencies, not the module itself, and nothing on the
    # dispatch side serves it — see generateDispatcherServesNothingCheck.
    Asserts.stringContains(
      selfClient,
      "serveModule(\"/" + path + "\")",
      "the module's own client should serve it for self calls",
    )

    null
  }

  """
  The file a call is dispatched into a module through should serve nothing.

  Serving belongs to the clients now: each clients/<module>.gen.ts serves its
  own module before the first query that reaches it, so neither loading path's
  dispatch file has a module list of its own to stage. Asserted on the
  entrypoint's dispatcher because that is the one this branch took the serving
  out of; the legacy entrypoint never had any.

  Matched on serveModule, the one call a serve goes through: the dispatcher still
  *mentions* serving, in a comment explaining that it does not, so the bare word
  says nothing.
  """
  generateDispatcherServesNothingCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let changes = Gen.scope(ws, path, "gendep", legacyRuntime: false)

    Asserts.generated(changes, path + "/__dagger.dispatch.ts")
    Asserts.assert(
      changes.after.directory(path).file("__dagger.dispatch.ts").contents.contains("serveModule") == false,
      "the entrypoint's dispatcher should not serve anything; each client serves its own module",
    )

    let runtimeChanges = Gen.module(ws, path, "gendep")
    Asserts.assert(
      runtimeChanges.after.directory(path).file("__dagger.entrypoint.ts").contents.contains("serveModule") == false,
      "the legacy entrypoint should not serve anything; each client serves its own module",
    )

    null
  }

  """
  Every scope recorded in dagger.toml should generate its own files.

  Workspace-wide generation is the engine's now — it reads the scope list, orders
  it, and calls this SDK once per scope — so what stays ours is that each scope
  named there really is one we can generate. A fixture removed from the tree but
  left in the config fails here rather than in the middle of a `dagger generate`.
  """
  generateEveryScopeCheck(ws: Workspace!): Void @check {
    # Threaded, in the order the config records them: a scope generated against
    # the result of the ones before it is what the engine does, and it is the
    # only way a dependent's schema can load.
    fixtures.managedScopes.reduce(ws) { staged, scope =>
      let changes = Gen.module(staged, scope.path, scope.name)
      Asserts.generated(changes, scope.path + "/sdk/index.ts")
      staged.withChanges(changes)
    }

    null
  }

  """
  Regenerating a current manifest preserves its engine version and dependencies.
  A manifest already in the helper's output format needs no change.
  """
  generatePreservesManifestCheck(ws: Workspace!): Void @check {
    let path = fixtures.depAppModule
    let manifest = path + "/dagger-module.toml"
    let staged = Gen.withDependency(ws)
    let changes = Gen.module(staged, path, "generate-deps-app")

    Asserts.notAdded(changes, manifest, "the manifest was already there")
    Asserts.assert(
      Asserts.contains(changes.modifiedPaths, manifest) == false,
      # From the workspace with the changes applied, not the changeset: the
      # message is built whether or not the assertion fails, and a manifest that
      # was left alone is not written, so it is not in the changeset to read.
      "regenerating rewrote the manifest as: " +
        staged.withChanges(changes).file("/" + manifest).contents,
    )

    # Nothing wrote it at all, which is the stronger statement and the one the
    # reported paths cannot make: they are diffed by content, so a manifest
    # re-emitted identically is absent from them either way.
    Asserts.untouched(changes, manifest, "regenerating should not rewrite the manifest")

    null
  }

  """
  A scope still configured by a pre-1.0 dagger.json is migrated to
  dagger-module.toml, and the dagger.json goes with it.

  Leaving both would leave the module with two manifests free to disagree, and
  the engine reads whichever it finds first. Migration only reaches a module
  the workspace records as a scope, so it happens because someone asked for it.

  The module's own source is generated, not scaffolded over: the starter is for
  a scope with no module at all, and rendering it here would overwrite the code
  being migrated.
  """
  generateMigratesLegacyConfigCheck(ws: Workspace!): Void @check {
    let path = fixtures.generateModule
    let changes = Gen.module(ws, path, "generate-app")
    let manifest = changes.after.directory(path).file("dagger-module.toml").contents

    Asserts.added(changes, path + "/dagger-module.toml")
    Asserts.assert(
      Asserts.contains(changes.removedPaths, path + "/dagger.json"),
      "migration should remove the pre-1.0 dagger.json, got removed [" +
        changes.removedPaths.join(", ") + "]",
    )
    Asserts.stringContains(
      manifest,
      "name = \"generate-app\"",
      "the migrated manifest should carry the scope's recorded name",
    )
    Asserts.stringContains(
      manifest,
      "source = \"typescript\"",
      "the migrated manifest should select the builtin typescript runtime",
    )
    # A dagger.json without a `source` means the manifest directory, and so does
    # a dagger-module.toml without one — so migration has nothing to write here.
    # The builder used to spell it out as `source = "."`, which made the file
    # this SDK writes differ from the one it would write on the next run.
    Asserts.stringNotContains(
      manifest,
      "\nsource = \".\"",
      "the migrated manifest should leave the default module source unwritten",
    )
    Asserts.assert(
      Asserts.contains(changes.modifiedPaths, path + "/src/index.ts") == false,
      "migrating an existing module should not scaffold over its source",
    )

    null
  }

  """
  Migrating a pre-1.0 module raises its engine pin to the release this SDK's
  bundle is built for.

  A module is served the core view of the release it pins, and its bindings are
  generated out of that view. Carried over, a pre-1.0 pin yields 0.21-shaped
  core bindings — no serveModule, old argument names — beside a module client
  that calls `__dag.serveModule(...)`, because that call is rendered from
  codegen's own template whatever the schema said. The two halves disagree: the
  module generates cleanly, `tsc` reports `Property 'serveModule' does not
  exist on type 'Client'`, and a call that reaches the serve dies with
  `__dag.serveModule is not a function`. A fresh module never sees this, because
  its manifest is pinned at the target release from the start; migration is
  where the old pin got in.

  The dependency is generated first and the module against the result, the
  order the engine runs the two scopes in.
  """
  generateMigrationRaisesEnginePinCheck(ws: Workspace!): Void @check {
    let path = fixtures.legacyPinAppModule
    let staged = ws.withChanges(Gen.module(ws, fixtures.legacyPinDepModule, "legacypindep"))
    let changes = Gen.module(staged, path, "legacy-pin-app")
    let tree = staged.withChanges(changes).directory("/" + path)

    Asserts.stringContains(
      tree.file("dagger-module.toml").contents,
      "engineVersion = \"v" + typescriptSdk.targetEngineVersion + "\"",
      "migration should raise a pre-1.0 engine pin to the release the bundle is built for",
    )
    Asserts.generated(changes, path + "/sdk/legacypindep.gen.ts")

    # Both halves of the pairing a pre-1.0 pin breaks. The call site is the
    # module's own client — a dependency's client has none, because a manifest
    # dependency is already served into the session — and it renders either
    # way, so on its own it proves nothing. The definition comes from the
    # schema view, and only a 1.0 one has it. Matched as the rendered property
    # (`serveModule = async (`) rather than the bare name, which also occurs in
    # the constructor and the field list.
    Asserts.stringContains(
      tree.file("sdk/legacy-pin-app.gen.ts").contents,
      "__dag.serveModule(",
      "the module's own client should serve it before its first query",
    )
    Asserts.stringContains(
      tree.file("sdk/client.gen.ts").contents,
      "serveModule = async (",
      "the core bindings should come from a 1.0 schema view, which is the one that defines serveModule",
    )

    null
  }

  """
  Regenerating a manifest still pinned to a pre-1.0 release raises the pin.

  Migration is not the only way a `[runtime]` module ends up on one: `dagger
  setup` writes dagger-module.toml itself and carries the dagger.json's
  engineVersion over, so a module it migrated never came through this SDK's
  migration at all, and a user who bumps nothing by hand keeps regenerating
  0.21-shaped bindings beside a 1.0 bundle. Regeneration is the one path every
  module takes, which is why the pin is checked there and not only when the
  manifest is first written.
  """
  generateRaisesLegacyEnginePinCheck(ws: Workspace!): Void @check {
    let path = fixtures.managedTomlLegacyPinModule
    let manifest = path + "/dagger-module.toml"
    let changes = Gen.module(ws, path, "managed-toml-legacy-pin")
    let tree = ws.withChanges(changes).directory("/" + path)

    Asserts.modified(changes, manifest)
    Asserts.stringContains(
      tree.file("dagger-module.toml").contents,
      "engineVersion = \"v" + typescriptSdk.targetEngineVersion + "\"",
      "regenerating should raise a pre-1.0 engine pin to the release the bundle is built for",
    )
    Asserts.stringContains(
      tree.file("sdk/client.gen.ts").contents,
      "serveModule = async (",
      "the core bindings should come from a 1.0 schema view, which is the one that has serveModule",
    )

    null
  }

  """
  Regenerating a manifest pinned to a 1.0 release leaves the pin alone.

  Only a pre-1.0 pin is raised. A 1.0 one is a choice someone made — an earlier
  beta the module is known to load on — and its view already has everything
  the generated clients call, so rewriting it would turn that choice into a
  diff on every `dagger generate`. Asserted on the layer, as
  generatePreservesManifestCheck does: a manifest re-emitted with its own bytes
  is absent from the reported paths either way.
  """
  generateKeepsEnginePinCheck(ws: Workspace!): Void @check {
    let path = fixtures.managedTomlBetaPinModule
    let changes = Gen.module(ws, path, "managed-toml-beta-pin")

    Asserts.generated(changes, path + "/sdk/client.gen.ts")
    Asserts.untouched(
      changes,
      path + "/dagger-module.toml",
      "regenerating should leave a 1.0 engine pin as it was written",
    )

    null
  }

  """
  A pre-1.0 dagger.json carrying config dagger-module.toml cannot express is
  refused rather than migrated.

  Migration deletes the dagger.json, so a field the manifest has no table for is
  a field the module loses. The builder validates `toolchains` and `blueprint`
  on load and emits neither, so migrating either one silently strips it —
  refusing keeps the original config where the user left it.
  """
  generateRefusesUnrepresentableConfigCheck(ws: Workspace!): Void @check {
    Asserts.stringContains(
      Gen.failure(Gen.module(ws, fixtures.migrateToolchainsModule, "migrate-toolchains")),
      "\"toolchains\"",
      "migrating a dagger.json declaring toolchains should be refused",
    )
    Asserts.stringContains(
      Gen.failure(Gen.module(ws, fixtures.migrateBlueprintModule, "migrate-blueprint")),
      "\"blueprint\"",
      "migrating a dagger.json declaring a blueprint should be refused",
    )

    null
  }

  """
  A pre-1.0 dagger.json belonging to another SDK is refused rather than
  migrated.

  The manifest builder copies whatever `sdk` names into `[runtime]`, so a scope
  mistakenly recorded as TypeScript over a Go module would have its config
  rewritten as a Go manifest, its dagger.json deleted, and its source run
  through TypeScript codegen.
  """
  generateRefusesForeignConfigCheck(ws: Workspace!): Void @check {
    Asserts.stringContains(
      Gen.failure(Gen.module(ws, fixtures.migrateNonTsModule, "migrate-not-ts")),
      "does not use the TypeScript SDK",
      "migrating another SDK's dagger.json should be refused",
    )

    null
  }

  """
  A module whose manifest points `source` at a Deno project elsewhere is
  regenerated as Deno.

  The runtime is detected from the config files sitting with the module's code,
  and in the split layout `dagger setup` produces those are not beside the
  manifest. Detecting at the manifest's directory finds no deno.json, so the
  module is written as a Node one — package.json and tsconfig.json laid into a
  Deno project, which then cannot resolve @dagger.io/dagger at all.
  """
  generateSplitSourceRuntimeCheck(ws: Workspace!): Void @check {
    let changes = Gen.module(ws, fixtures.splitDenoModule, "split-deno-app")

    Asserts.generated(changes, fixtures.splitDenoCode + "/sdk/client.gen.ts")
    Asserts.generated(changes, fixtures.splitDenoCode + "/deno.json")

    Asserts.notAdded(
      changes,
      fixtures.splitDenoCode + "/package.json",
      "a split-layout Deno module should not be given a package.json",
    )
    Asserts.notAdded(
      changes,
      fixtures.splitDenoCode + "/tsconfig.json",
      "a split-layout Deno module resolves through deno.json, not tsconfig paths",
    )

    Asserts.stringContains(
      changes.after.directory(fixtures.splitDenoCode).file("deno.json").contents,
      "./sdk/index.ts",
      "deno.json should import @dagger.io/dagger from the generated sdk",
    )

    null
  }

  """
  Generating a scope twice writes nothing the second time.

  Generation is the scope's whole desired state, so applying it has to be a
  fixed point: anything that differs run to run — a timestamp, a reordered map,
  a path written relative to the wrong root — turns every `dagger generate` into
  a diff and makes it impossible to tell a real change from noise.
  """
  generateIdempotentCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let settled = ws.withChanges(Gen.module(ws, path, "gendep"))
    let again = Gen.module(settled, path, "gendep")

    Asserts.assert(
      again.isEmpty,
      "regenerating a settled scope should write nothing, got added [" +
        again.addedPaths.join(", ") + "], modified [" + again.modifiedPaths.join(", ") + "]",
    )

    null
  }

  """
  Editing a module's source should write only the files that edit reaches.

  Generation re-renders every file whether or not the edit changed it, and most
  of them come out identical: the core API bindings describe the engine's
  schema, and the client package's config describes the package, neither of
  which a new function touches. Writing them anyway is not a harmless no-op. The
  changeset the engine hands back records what was *written*, not what changed,
  so a file rewritten with its own bytes is carried in it and reported against a
  base sized from the paths that really changed — as an addition, whole. One
  added function used to report both binding files, 18k unchanged lines, as
  brand new.

  Asserted on the changeset's layer, not on the paths it reports. The reported
  paths are diffed by content and were right all along, so a check reading them
  passes on the bug; the layer is what carries the rewrite. The end-to-end
  symptom needs generated files on disk, which no check here has —
  `design/regeneration-churn.md` records how to reproduce it by hand, and that
  it must be done in both directions, since the first attempt at a fix was clean
  on removal and three times worse on addition.
  """
  generateSourceEditIsScopedCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let source = path + "/src/index.ts"
    let settled = ws.withChanges(Gen.scope(ws, path, "gendep"))

    # A new @func, so the module's own schema really does change and its self
    # client and entrypoint really are re-rendered. Anything less and this
    # passes on a run that generated nothing.
    let edited = settled.withNewFile(
      "/" + source,
      settled.file("/" + source).contents.trimSuffix("}\n") +
        "\n  @func()\n  extra(): string {\n    return \"extra\"\n  }\n}\n",
    )
    let changes = Gen.scope(edited, path, "gendep")

    Asserts.generated(changes, path + "/sdk/gendep.gen.ts")
    Asserts.generated(changes, path + "/__dagger.entrypoint.ts")

    # The library is core-only and unchanged by a source edit; so are the config
    # files (no client added or removed) and the loader (no new type).
    [
      "/sdk/client.gen.ts",
      "/sdk/core.js",
      "/sdk/loader.gen.ts",
      "/package.json",
      "/tsconfig.json",
    ].each { name =>
      Asserts.untouched(
        changes,
        path + name,
        "editing a module's source should not rewrite " + name.trimPrefix("/"),
      )
    }

    null
  }

  """
  A module whose source imports its own client must keep it through
  regeneration.

  Loading a [runtime] module executes its TypeScript, and the self client only
  renders in the second pass — so the first pass's staged tree must keep the
  previous generation's <self>.gen.ts for the import to resolve, or the load
  fails, the second pass never runs, and the prune deletes the very file the
  source needs. That exact sequence shipped once: uncommenting a self-call
  erased sdk/<self>.gen.ts on the next generate.
  """
  generateSelfImportSurvivesCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let source = path + "/src/index.ts"
    let settled = ws.withChanges(Gen.scope(ws, path, "gendep"))

    # The source now imports and calls its own generated client.
    let edited = settled.withNewFile(
      "/" + source,
      "import { gendep } from \"@dagger.io/gendep\"\n" +
        settled.file("/" + source).contents.trimSuffix("}\n") +
        "\n  @func()\n  viaSelf(): string {\n    return typeof gendep\n  }\n}\n",
    )
    let changes = Gen.scope(edited, path, "gendep")

    let removed = "removed [" + changes.removedPaths.join(", ") + "]"
    Asserts.assert(
      Asserts.contains(changes.removedPaths, path + "/sdk/gendep.gen.ts") == false,
      "regenerating a module that imports its own client removed the client: " + removed,
    )
    # The second pass ran: the self client is re-rendered with the new function
    # on it, not merely left alone.
    Asserts.generated(changes, path + "/sdk/gendep.gen.ts")
    Asserts.stringContains(
      changes.after.directory(path).file("sdk/gendep.gen.ts").contents,
      "viaSelf",
      "the self client should carry the function added alongside the self import",
    )

    null
  }

  """
  A module with a local dependency should get bindings for it.

  Dependency edges still exist in a manifest even though new wiring goes through
  clients, and the dependency's client file is what the module's source imports
  through @dagger.io/dagger/<dep>.
  """
  generateDependencyBindingsCheck(ws: Workspace!): Void @check {
    let changes = Gen.module(Gen.withDependency(ws), fixtures.depAppModule, "generate-deps-app")

    Asserts.generated(changes, fixtures.depAppModule + "/sdk/gendep.gen.ts")
    Asserts.notAdded(
      changes,
      fixtures.depLibModule + "/sdk/index.ts",
      "generating a dependent should not also write its dependency's files",
    )

    null
  }

  """
  A module with clients should get the compat shim that keeps pre-1.0
  `dag.<module>()` source working.

  Unified clients moved every module's root fields off the core Client onto a
  client of its own, so a module migrated from 0.21.x compiles — a
  type-stripping loader checks nothing — and then fails at dispatch with
  "dag.gendep is not a function". The shim puts those fields back as deprecated
  delegating methods.

  A file of its own because core may not reference a module client: that
  direction is an ESM cycle and would stop sdk/ being a publishable core-only
  library. So the assertions here are as much about what the shim does *not*
  touch — the core bindings stay core-only — as about what it restores.
  """
  generateCompatShimCheck(ws: Workspace!): Void @check {
    let path = fixtures.depAppModule
    let staged = Gen.withDependency(ws)
    let changes = Gen.module(staged, path, "generate-deps-app")
    let tree = staged.withChanges(changes).directory("/" + path)

    Asserts.generated(changes, path + "/sdk/compat.gen.ts")

    let compat = tree.file("sdk/compat.gen.ts").contents
    Asserts.stringContains(
      compat,
      "__install(\"gendep\"",
      "the shim should restore the dependency's root field on the core client",
    )
    Asserts.stringContains(
      compat,
      "import { dag as __dagGendep } from \"@dagger.io/gendep\"",
      "it should delegate through the dependency's own dag, so the client's serve-on-use hook still runs",
    )
    Asserts.stringContains(
      compat,
      "@deprecated",
      "every restored field should say what to use instead",
    )
    Asserts.stringContains(
      compat,
      "declare module \"@dagger.io/dagger\"",
      "the type side should reach the Client the module's own source imports",
    )

    # The loader is what evaluates the shim, and the entrypoint imports the
    # loader for its side effect as well as for __loadObject — a module with no
    # object-typed signature never calls the latter, and a type-stripping loader
    # drops an unused named import outright.
    Asserts.stringContains(
      tree.file("sdk/loader.gen.ts").contents,
      "import \"./compat.gen.js\"",
      "the loader should import the shim so it is installed before any dispatch",
    )
    Asserts.stringContains(
      tree.file("__dagger.entrypoint.ts").contents,
      "import \"./sdk/loader.gen.js\"",
      "the entrypoint should load the loader for its side effect, not only for __loadObject",
    )

    # The invariant the separate file exists to keep.
    Asserts.assert(
      tree.file("sdk/client.gen.ts").contents.contains("compat.gen.js") == false,
      "the core bindings must not reference the compat shim",
    )

    null
  }

  """
  A scope with no module client should get no compat shim, and should lose one
  left behind.

  Asserted on an entrypoint module because that is the layout where "no
  clients" is reachable: its self client is opt-in, so a module with no
  dependency and no recorded target renders none at all. The embedded
  `[runtime]` layout always generates its own self client, so it always has at
  least one module client to restore.

  The planted file is the pruning half. clients/ is fully generated under an
  entrypoint, so anything in it this run does not render is stale — the same
  mechanism that takes a departed dependency's bindings, which the shim has to
  be subject to or a module that drops its last client keeps a shim importing
  a client that is gone.
  """
  generateCompatShimPrunedCheck(ws: Workspace!): Void @check {
    let scope = Fixtures.out + "/compat-none"
    let stale = scope + "/clients/compat.gen.ts"

    let dirty = ws.withNewFile("/" + stale, "export {}\n")
    let changes = Gen.scope(dirty, scope, "compat-none", template: "empty", legacyRuntime: false)

    Asserts.notGenerated(
      changes,
      stale,
      "a scope with no module client has nothing to restore on the core client",
    )
    Asserts.assert(
      Asserts.contains(changes.removedPaths, stale),
      "regeneration should remove a compat shim the scope no longer renders, got removed [" +
        changes.removedPaths.join(", ") + "]",
    )

    null
  }

  """
  The restored `dag.<dep>()` should type-check, through the module's own
  tsconfig.

  The runtime half is covered by `runtimes:dag-dependency-runs`, which loads a
  module that really calls one. This is the other half, and the one the issue
  is about: the call used to be invisible to every tool a user runs — `generate`
  and `check` passed, and the module failed only when dispatched. With the shim
  the type is declared, so a plain `tsc --noEmit` accepts the call.

  Run through the module's own tsconfig, unnarrowed, because that is what makes
  the declaration merge apply at all: an augmentation only takes effect when the
  augmenting file is in the program, and the generated tsconfig carries no
  `include`, so a user's `tsc` compiles the whole module — sdk/compat.gen.ts
  with it. Narrowing `include` to the probe is what a first draft of this check
  did, and it failed exactly as a user would if the shim were never imported.

  Both directions, because the compile passing says nothing on its own: the same
  source is rejected once the shim is taken away. tsc prints nothing for
  @deprecated — an editor shows the strike-through — so a clean compile is the
  whole assertion.
  """
  generateCompatShimTypeChecksCheck(ws: Workspace!): Void @check {
    let path = fixtures.depAppModule
    let staged = Gen.withDependency(ws)
    let tree = staged.withChanges(Gen.module(staged, path, "generate-deps-app")).directory("/" + path)

    Asserts.stringContains(
      tree.file("tsconfig.json").contents,
      "\"@dagger.io/gendep\"",
      "the module's tsconfig should alias the dependency's client, which the probe resolves through",
    )

    Asserts.assert(
      compatProbe(tree) == "compiled",
      "a pre-1.0 dag.gendep() call should type-check against the generated tree",
    )
    Asserts.assert(
      compatProbe(tree.withoutFile("sdk/compat.gen.ts")) == "rejected",
      "without the shim the same call should not type-check — otherwise this check proves nothing",
    )

    null
  }

  """
  Type-check a pre-1.0 `dag.gendep()` call against a generated module tree:
  "compiled" or "rejected".
  """
  let compatProbe(tree: Directory!): String! {
    let probe = "import { dag } from \"@dagger.io/dagger\"\n" +
      "export async function viaDag(): Promise<string> {\n" +
      "  return await dag.gendep().value()\n" +
      "}\n"

    {
      let out = container
        .from("node:22-alpine")
        .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
        .withDirectory("/app", tree)
        .withWorkdir("/app")
        .withNewFile("/app/compat-probe.ts", probe)
        # @types/node because the whole module is in the program, and the
        # generated entrypoint reads `process` — a module's own dependency, not
        # something the probe is testing.
        .withExec(["npm", "install", "--no-audit", "--no-fund", "typescript@5.9.3", "@types/node@22.10.2"])
        .withExec(["npx", "--no-install", "tsc", "--noEmit", "-p", "tsconfig.json"])
        .stdout
      "compiled"
    } rescue {
      err: Error => "rejected"
    }
  }

  """
  A module generated on a Git workspace should come out the same as on a local
  checkout.

  Dagger Cloud runs a repository's checks by loading it as an address
  (`github.com/org/repo@<sha>`), and the engine loads such a workspace's own
  modules as Git sources. Left alone, the module's own client serves itself by
  that commit-pinned ref and its source-map comments become commit URLs — output
  carrying the very commit being generated, which no committed file can match,
  so a generated-files check can never pass in CI. Local generation never sees
  it, which is why this repository is its own fixture at a fixed commit: a
  Directory-backed repo (`asGit`) still loads as a DIR_SOURCE, so a real remote
  is the only way to get a Git workspace.
  """
  generatesOnGitWorkspaceCheck: Void @check {
    let ws = git("https://github.com/dagger/typescript-sdk").ref(gitCommit).asWorkspace
    let path = fixtures.depLibModule

    Asserts.assert(
      ws.moduleSource("/" + path).kind == ModuleSourceKind.GIT_SOURCE,
      "expected a Git workspace to load its own module as a Git source",
    )

    let bindings = ws
      .withChanges(Gen.module(ws, path, "gendep"))
      .directory("/" + path)
      .file("sdk/gendep.gen.ts")
      .contents

    Asserts.stringContains(
      bindings,
      "serveModule(\"/" + path + "\")",
      "a Git workspace's own module should be served by workspace path, not by its commit-pinned ref",
    )
    Asserts.stringNotContains(
      bindings,
      gitCommit,
      "generated bindings should not carry the commit they were generated at",
    )

    null
  }

  """
  The same for a client-only scope, which has no module of its own to read the
  repository off — the one configuration where the module check above passes and
  the output still carries the commit.
  """
  generatesClientOnGitWorkspaceCheck: Void @check {
    let ws = git("https://github.com/dagger/typescript-sdk").ref(gitCommit).asWorkspace
    let scope = fixtures.clientOutput
    let target = fixtures.clientModule

    let client = ws
      .withChanges(Gen.scope(ws, scope, "", isModule: false, clients: [ws.moduleSource("/" + target)]))
      .directory("/" + scope + "/clients")
      .file("client-app/client-app.gen.ts")
      .contents

    Asserts.stringContains(
      client,
      "serveModule(\"/" + target + "\")",
      "a client bound to a same-repository module should serve it by workspace path",
    )
    Asserts.stringNotContains(
      client,
      gitCommit,
      "a generated client should not carry the commit it was generated at",
    )

    null
  }

  """
  The commit of this repository the Git-workspace checks load. Only the fixture
  tree at that commit is read; the SDK under test is the local one.
  """
  let gitCommit: String! = "249ba5a1d704a55034139e72005e445df7672150"

  """
  A `[runtime]` module's clients/ holds the user's files too, and regeneration
  takes only its own out of it.

  An earlier layout kept the module's clients there, flat beside sdk/, and the
  move into sdk/ makes every one of them stale — so a leftover <m>.gen.ts goes.
  It used to go by deleting the directory, which took whatever else was in it.
  Ownership is by shape: a file of the user's beside the stale client stays,
  and the directory stays with it. Staged rather than fixtured, like the stale
  bindings above — nothing generated today leaves a clients/ beside sdk/.
  """
  generateKeepsUserFilesInClientsDirCheck(ws: Workspace!): Void @check {
    let path = fixtures.depLibModule
    let stale = path + "/clients/departed.gen.ts"
    let notes = path + "/clients/notes.txt"

    let dirty = ws
      .withNewFile("/" + stale, "export const gone = true\n")
      .withNewFile("/" + notes, "user notes\n")
    let changes = Gen.module(dirty, path, "gendep")
    let removed = ", got removed [" + changes.removedPaths.join(", ") + "]"

    Asserts.assert(
      Asserts.contains(changes.removedPaths, stale),
      "regeneration should take a flat client an earlier layout left in clients/" + removed,
    )
    Asserts.assert(
      Asserts.contains(changes.removedPaths, notes) == false,
      "regeneration removed a user's file from a module's clients/" + removed,
    )
    Asserts.assert(
      Asserts.contains(changes.removedPaths, path + "/clients/") == false,
      "regeneration removed a module's clients/ with a user's file still in it" + removed,
    )
    Asserts.assert(
      Asserts.contains(dirty.withChanges(changes).directory("/" + path + "/clients").entries, "notes.txt"),
      "a user's file in a module's clients/ must survive regeneration",
    )

    null
  }

  """
  Migrating a pre-1.0 module takes the `/sdk` and `/__dagger.entrypoint.ts`
  lines out of its .gitignore, and nothing else.

  The v0.21 engine wrote them because its runtime regenerated both at call
  time. A 1.0 module commits them — the trusted runtime does no codegen — and
  source loading honours .gitignore before the runtime sees the tree, so the
  lines hide the very files the module needs: `committed generated file
  "sdk/client.gen.ts" is missing`, with the file on disk (SDK Main-Engine Test
  Run, 2026-10-07 — issue #25, case G14). dagger/dagger#13720 taught `dagger
  setup` the same removal, but it learns the lines from a legacy SDK's codegen,
  which an SDK-module provider has none of — so a module this SDK converts
  kept them.

  The other rules describe nothing a module commits and stay as they were. The
  file is asserted whole rather than line by line, so a survivor that was
  reordered or reformatted fails too.
  """
  generateCleansLegacyIgnoreCheck(ws: Workspace!): Void @check {
    let path = fixtures.legacyDepAppModule
    let ignore = path + "/.gitignore"
    let staged = Gen.withLegacyDependency(ws)
    let changes = Gen.module(staged, path, "legacy-deps-app")
    let cleaned = staged.withChanges(changes).file("/" + ignore).contents

    Asserts.modified(changes, ignore)
    Asserts.assert(
      Asserts.contains(cleaned.split("\n"), "/sdk") == false,
      "migration should drop the /sdk ignore that hides the committed library, got:\n" + cleaned,
    )
    Asserts.assert(
      Asserts.contains(cleaned.split("\n"), "/__dagger.entrypoint.ts") == false,
      "migration should drop the /__dagger.entrypoint.ts ignore that hides the committed entrypoint, got:\n" + cleaned,
    )
    Asserts.assert(
      cleaned == "/**/node_modules/**\n/**/.pnpm-store/**\n/.env\n",
      "the rules naming no generated file should survive byte for byte, got:\n" + cleaned,
    )

    null
  }

  """
  A .gitignore already cleaned is not written again.

  The cleanup runs on every generation — a manifest an earlier SDK version or
  `dagger setup` wrote has already lost the dagger.json that would mark the
  module as migrating — so it has to be a no-op on the file it fixed last time.
  Asserted on the changeset's layer: a rewrite with the same bytes is absent
  from the reported paths and still lands on disk, where the next generate
  reports it whole (see Asserts.untouched).
  """
  generateLegacyIgnoreSettlesCheck(ws: Workspace!): Void @check {
    let path = fixtures.legacyDepAppModule
    let staged = Gen.withLegacyDependency(ws)
    let settled = staged.withChanges(Gen.module(staged, path, "legacy-deps-app"))
    let again = Gen.module(settled, path, "legacy-deps-app")

    Asserts.untouched(
      again,
      path + "/.gitignore",
      "regenerating should not rewrite a .gitignore it already cleaned",
    )

    null
  }

  """
  A module with no .gitignore gets none, and one whose .gitignore names no
  generated file is left alone.

  The cleanup only ever removes lines the pre-1.0 engine wrote. Creating the
  file would hand every module an ignore list it never asked for, and
  rewriting one that carries nothing to remove puts it in the changeset with
  its own bytes — the churn writeChanged exists to avoid.
  """
  generateLeavesOtherIgnoresCheck(ws: Workspace!): Void @check {
    # A fresh scope: nothing there, so nothing to clean and nothing to create.
    let fresh = fixtures.out + "/no-ignore"
    Asserts.untouched(
      Gen.scope(ws, fresh, "no-ignore"),
      fresh + "/.gitignore",
      "generation should not create a .gitignore",
    )

    # A current module's .gitignore — node_modules, pnpm-store and .env rules
    # only, which is what the dependency fixture carries.
    Asserts.untouched(
      Gen.module(ws, fixtures.depLibModule, "gendep"),
      fixtures.depLibModule + "/.gitignore",
      "a .gitignore naming no generated file should not be rewritten",
    )

    null
  }
}
