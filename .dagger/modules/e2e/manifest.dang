"""Checks for workspace manifest generation."""
type ManifestChecks {
  """Lock changes apply to existing dependencies with no requested clients."""
  pinsCheck(ws: Workspace!): Void @check {
    let commit = "64645f1967d3dba6fce951dd61ae4acd8d9b0861"
    let target = moduleSource("github.com/dagger/sdk-helpers@" + commit)
    let path = Fixtures.out + "/manifest-pins"
    let input = ws.withNewFile(path + "/keep.txt", "keep").withWorkdir(path)
    let unlocked = typescriptSdk(template: "empty", skipGenerateFilename: "").generateScope(input, isModule: true, name: "manifest-pins", clients: [target])
    Asserts.stringNotContains(unlocked.file("dagger-module.toml").contents, "pin =", "default output contains a pin")
    Asserts.stringContains(unlocked.file("dagger-module.toml").contents, target.asString, "Git source changed")
    let locked = typescriptSdk(lock: true, skipGenerateFilename: "").generateScope(unlocked, isModule: true, name: "manifest-pins", clients: [target])
    Asserts.stringContains(locked.file("dagger-module.toml").contents, "pin = \"" + commit + "\"", "selected commit was lost")
    let noClients = typescriptSdk(lock: true, skipGenerateFilename: "").generateScope(locked, isModule: true, name: "manifest-pins", clients: [])
    Asserts.stringContains(noClients.file("dagger-module.toml").contents, "pin = \"" + commit + "\"", "loaded pin was lost")
    let unlockedAgain = typescriptSdk.generateScope(noClients.withNewFile("dagger.json", "stale"), isModule: true, name: "manifest-pins", clients: [])
    let manifest = unlockedAgain.file("dagger-module.toml").contents
    Asserts.stringNotContains(manifest, "pin =", "disabling lock retained a pin with no clients")
    Asserts.stringContains(manifest, target.asString, "generation removed an existing dependency")
    Asserts.assert(!unlockedAgain.directory(".").exists("dagger.json"), "generation retained JSON")
    Asserts.assert(unlockedAgain.cwd == input.cwd, "generation changed cwd")
    Asserts.assert(unlockedAgain.file("keep.txt").contents == "keep", "generation changed another file")
    # Loaded manifests preserve pins; only supplied ModuleSources provide missing pins.
    let lockedAgain = typescriptSdk(lock: true, skipGenerateFilename: "").generateScope(unlockedAgain, isModule: true, name: "manifest-pins", clients: [])
    Asserts.stringNotContains(lockedAgain.file("dagger-module.toml").contents, "pin =", "locking invented a pin without a supplied module source")
    let repeated = typescriptSdk(lock: true, skipGenerateFilename: "").generateScope(lockedAgain, isModule: true, name: "manifest-pins", clients: [])
    Asserts.assert(repeated.changes(lockedAgain).isEmpty, "repeated generation changed the workspace")
    null
  }

  """A local dependency path starts at the manifest, even with separate source files."""
  splitSourceClientCheck(ws: Workspace!): Void @check {
    let dependency = Fixtures.splitDenoRoot + "/dep"
    let input = ws
      .withNewFile(dependency + "/dagger.json", "{\"name\":\"manifest-dep\",\"engineVersion\":\"v0.21.9\",\"sdk\":\"dang\"}")
      .withNewFile(dependency + "/main.dang", "type ManifestDep { hello: String! { \"hello\" } }")
      .withWorkdir(Fixtures.splitDenoModule)
    let target = input.withWorkdir(".").moduleSource("/" + dependency).withName("alias")
    let generated = typescriptSdk(lock: true, skipGenerateFilename: "").generateScope(input, isModule: true, name: "split-deno-app", clients: [target])
    let manifest = generated.file("dagger-module.toml").contents
    Asserts.stringContains(manifest, "source = \"../../../dep\"", "dependency path does not start at the manifest")
    Asserts.stringContains(manifest, "name = \"manifest-dep\"", "original module name was lost")
    Asserts.stringNotContains(manifest, "pin =", "local dependency has a pin")
    Asserts.assert(generated.cwd == input.cwd, "generation changed cwd")
    Asserts.assert(generated.directory("/").exists(Fixtures.splitDenoCode + "/sdk/manifest-dep.gen.ts"), "module client was not generated beside the source")
    Asserts.assert(generated.directory("/").exists(Fixtures.splitDenoCode + "/deno.json"), "Deno config was lost")
    null
  }
}
