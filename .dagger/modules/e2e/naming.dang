"""
Generate and call a module whose schema names differ between the engine's
identifier naming rules and the legacy strcase rules. The generated
entrypoints predict the names the engine gives the module's declarations, at
the version the engine names the module by: the namespaced interface, the
function a call through it selects.

It needs an engine at v1.0.0-beta.22 or later, so no check runs it yet:

  dagger -m .dagger/modules/e2e call naming calls-check --ws .
"""
type NamingChecks {
  let fixture: String! = Fixtures.root + "/naming/app"

  """
  The fixture generated as an entrypoint module. With pinned, the entrypoint's
  dang.toml declares v1.0.0-beta.22; without one, the engine names the module
  by v1.0.0-beta.20.
  """
  generated(ws: Workspace!, pinned: Boolean! = false): Directory! {
    generatedScope(ws, pinned).withWorkdir(".").directory("/naming-app")
  }

  """
  The module is generated in a workspace of its own, so nothing of this
  repository's configuration is in the way of the dang.toml the engine reads
  the module's version from.
  """
  let generatedScope(ws: Workspace!, pinned: Boolean!): Workspace! {
    let module = ws.directory("/" + fixture)
    let source = if (pinned) {
      module.withNewFile("entrypoint/dang.toml", "[imports.Dagger]\ndagger = \"v1.0.0-beta.22\"\n")
    } else { module }
    typescriptSdk(legacyRuntime: false, skipGenerateFilename: "").generateScope(
      ws: directory.withDirectory("naming-app", source).asWorkspace.withWorkdir("naming-app"),
      isModule: true, name: "naming-app", clients: [],
    )
  }

  """
  The dispatcher predicts the module's schema names by the version the engine
  names it by, and the module's self-call reaches its namespaced interface by
  them, with and without a pinned version.
  """
  callsCheck(ws: Workspace!): Void {
    [
      {{pinned: false, names: ["selectNode(id, \"NamingAppHttpFetcher\")", "select(\"e2Etest\", __args)", "select(\"getUrl\", __args)"]}},
      {{pinned: true, names: ["selectNode(id, \"NamingAppHTTPFetcher\")", "select(\"e2eTest\", __args)", "select(\"getUrl\", __args)"]}},
    ].each { want =>
      let label = if (want.pinned) { "the pinned module" } else { "the module without a version" }
      let staged = generatedScope(ws, want.pinned).withWorkdir(".")
      let dispatcher = staged.file("/naming-app/__dagger.dispatch.ts").contents
      want.names.each { name =>
        Asserts.stringContains(dispatcher, name, label + "'s dispatcher lacks " + name)
      }
      let outcomes = staged.withModule("naming-app", name: "naming-app")
        .artifacts(include: ["naming-app:self-call-check"]).asChecks
        .{{ pass, error.{{ message }} }}
      Asserts.assert(outcomes.length == 1, label + ": expected the self-call check, got " + toString(outcomes.length))
      # Selected on `pass` first: reading the message of a check that passed
      # raises an evaluation error of its own.
      let failed = outcomes.filter { c => c.pass == false }.map { c => c.error.message }
      Asserts.assert(failed.length == 0, label + "'s self-call failed: " + failed.join("\n"))
    }
    null
  }
}
