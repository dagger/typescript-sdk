"""
Checks for the SDK-level surface the engine and callers read directly:
the runtime it targets, the skip marker it honors, and the templates it ships.
"""
type SdkChecks {
  """
  A module this SDK creates should name the engine's builtin TypeScript runtime.
  The SDK writes the manifest now, so this is what points every generated module
  at the runtime that executes it — getting it wrong produces modules that will
  not load.
  """
  targetRuntimeCheck(ws: Workspace!): Void @check {
    let path = Fixtures.out + "/runtime-source"
    let changes = Gen.module(ws, path, "runtime-source")

    Asserts.stringContains(
      changes.layer.file(path + "/dagger-module.toml").contents,
      "source = \"typescript\"",
      "a generated manifest should select the builtin typescript runtime",
    )

    null
  }

  """
  The generate skip marker should stop generation for everything at or below the
  directory holding it. It is the SDK's contract with the repos that drop the
  file: renaming it, or narrowing it to the marked directory alone, silently
  starts regenerating trees that opted out.

  Checked through the marker's effect rather than its name, because the filename
  is private — a setting would be the wrong shape for something that has to work
  from an ancestor.
  """
  skipMarkerCheck(ws: Workspace!): Void @check {
    # The fixture carries the marker one directory above the module.
    let changes = Gen.module(ws, Fixtures.managedTomlModule, "managed-toml-app")

    Asserts.assert(
      changes.isEmpty,
      "a scope under the skip marker should generate nothing, got: " + changes.addedPaths.join(", "),
    )

    null
  }

  """
  Every directory under templates/ should be offered to `module init --template`,
  named after the directory.
  """
  templatesCheck: Void @check {
    let names = typescriptSdk.templates.{{name}}.map { t => t.name }

    Asserts.assert(Asserts.contains(names, "default"), "the default template should be listed")
    Asserts.assert(Asserts.contains(names, "empty"), "the empty template should be listed")

    null
  }

  """
  Every managed fixture should target the engine release this SDK's bundle is
  built for.

  A fixture left on an older release still generates and still loads, so it goes
  on passing every other check here while covering an engine we no longer ship
  for — which is how all three runtime fixtures sat at beta.9, and four more at
  beta.7, through a bump nobody noticed missing them.
  """
  fixtureEngineVersionCheck(ws: Workspace!): Void @check {
    let want = "engineVersion = \"v" + typescriptSdk.targetEngineVersion + "\""

    Fixtures.managedTomlFixtures.each { path =>
      Asserts.stringContains(
        ws.directory("/" + path).file("dagger-module.toml").contents,
        want,
        path + " should target the engine release this SDK ships for (" + want + ")",
      )
    }

    null
  }

  """
  The Go helpers (codegen, config-updater) must pass their own unit + golden
  tests. Runs `go test` in a container so `dagger check` covers the codegen
  logic, not just its end-to-end output.
  """
  helperTestsCheck(ws: Workspace!): Void @check {
    let out = container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helpers", ws.directory("helpers"))
      .withWorkdir("/helpers/codegen")
      .withExec(["go", "test", "./..."])
      .withWorkdir("/helpers/config-updater")
      .withExec(["go", "test", "./..."])
      .stdout

    null
  }
}
