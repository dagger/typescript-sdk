"""
Checks for seeding a new module scope.

`generateScope` serves both init and regeneration; these cover the init half,
where the scope holds no `dagger-module.toml` yet and the SDK lays down the
starter, the runtime's config files, and the manifest.
"""
type InitChecks {
  let fixtures: Fixtures! = Fixtures

  """
  Seeding should lay down the starter, the manifest, and the config files the
  chosen runtime is detected from — and nothing belonging to the legacy format.
  """
  initCheck(ws: Workspace!): Void @check {
    let defaultPath = fixtures.out + "/init-default"
    let bunPath = fixtures.out + "/init-bun"
    let denoPath = fixtures.out + "/init-deno"

    let defaultChanges = Gen.scope(ws, defaultPath, "init-default")
    let bunChanges = Gen.scope(ws, bunPath, "init-bun", runtime: "bun")
    let denoChanges = Gen.scope(ws, denoPath, "init-deno", runtime: "deno")

    Asserts.notAdded(
      defaultChanges,
      defaultPath + "/dagger.json",
      "seeding should write the CLI 1.0 manifest, never a legacy dagger.json",
    )
    # The manifest is the SDK's to write, and its absence is what marks a scope
    # as not yet seeded — so a run that skipped it would re-seed forever.
    Asserts.added(defaultChanges, defaultPath + "/dagger-module.toml")
    Asserts.added(defaultChanges, defaultPath + "/src/index.ts")
    Asserts.added(defaultChanges, defaultPath + "/package.json")
    Asserts.added(defaultChanges, defaultPath + "/tsconfig.json")
    Asserts.notAdded(defaultChanges, defaultPath + "/index.ts", "init should not generate index.ts at the module root")
    Asserts.notAdded(defaultChanges, defaultPath + "/deno.json", "node init should not generate deno.json")
    Asserts.notAdded(defaultChanges, defaultPath + "/bun.lock", "node init should not generate bun.lock")
    Asserts.assert(defaultChanges.modifiedPaths.length == 0, "seeding a fresh scope should modify nothing")
    Asserts.assert(defaultChanges.removedPaths.length == 0, "seeding a fresh scope should remove nothing")
    # Seeding runs into generation in the same call, so the bindings the runtime
    # loads are there from the first run rather than a `dagger generate` later.
    Asserts.added(defaultChanges, defaultPath + "/sdk/client.gen.ts")
    Asserts.added(defaultChanges, defaultPath + "/__dagger.entrypoint.ts")

    # Bun reuses the Node config files and adds the lockfile the runtime sniffs
    # for to pick bun over node.
    Asserts.added(bunChanges, bunPath + "/src/index.ts")
    Asserts.added(bunChanges, bunPath + "/package.json")
    Asserts.added(bunChanges, bunPath + "/tsconfig.json")
    Asserts.added(bunChanges, bunPath + "/bun.lock")

    Asserts.added(denoChanges, denoPath + "/src/index.ts")
    Asserts.added(denoChanges, denoPath + "/deno.json")
    Asserts.notAdded(denoChanges, denoPath + "/package.json", "deno init should not generate package.json")
    Asserts.notAdded(denoChanges, denoPath + "/tsconfig.json", "deno init should not generate tsconfig.json")

    null
  }

  """
  The default template should render a working module (a class with a container
  function that reads source from the workspace), and the empty template should
  render a bare @object class. Both must have their {{ .ModuleName }}
  placeholder fully substituted.
  """
  templateCheck(ws: Workspace!): Void @check {
    let defaultPath = fixtures.out + "/template-default"
    let emptyPath = fixtures.out + "/template-empty"

    let defaultChanges = Gen.scope(ws, defaultPath, "template-default")
    let defaultIndex = defaultChanges.layer.file(defaultPath + "/src/index.ts").contents
    Asserts.stringContains(defaultIndex, "export class TemplateDefault", "default template should render the module class")
    Asserts.stringContains(defaultIndex, "container(): Container", "default template should expose the container function")
    Asserts.stringContains(defaultIndex, "ws.directory(", "default template constructor should read source from the workspace")
    Asserts.stringContains(defaultIndex, "baseImageAddress", "default template should expose the base image field")
    Asserts.stringNotContains(defaultIndex, "{{", "default template placeholders should be fully rendered")

    let emptyChanges = Gen.scope(ws, emptyPath, "template-empty", template: "empty")
    Asserts.added(emptyChanges, emptyPath + "/src/index.ts")
    Asserts.added(emptyChanges, emptyPath + "/package.json")
    let emptyIndex = emptyChanges.layer.file(emptyPath + "/src/index.ts").contents
    Asserts.stringContains(emptyIndex, "export class TemplateEmpty {}", "empty template should render a bare class")
    Asserts.stringNotContains(emptyIndex, "{{", "empty template placeholders should be fully rendered")

    # An unnamed template means the default, not the templates/ directory —
    # which exists, so it would render every starter as a subdirectory.
    let unnamedPath = fixtures.out + "/template-unnamed"
    let unnamedChanges = Gen.scope(ws, unnamedPath, "template-unnamed", template: "")
    Asserts.added(unnamedChanges, unnamedPath + "/src/index.ts")
    Asserts.notAdded(
      unnamedChanges,
      unnamedPath + "/default/src/index.ts",
      "an unnamed template should render the default starter, not every starter",
    )
    Asserts.stringContains(
      unnamedChanges.layer.file(unnamedPath + "/src/index.ts").contents,
      "export class TemplateUnnamed",
      "an unnamed template should render the default starter",
    )

    null
  }

  """
  Init against a path that already contains user-authored package.json,
  tsconfig.json, or deno.json should merge Dagger-required keys into those
  files instead of clobbering them.
  """
  initRespectsExistingCheck(ws: Workspace!): Void @check {
    let nodeChanges = Gen.scope(ws, fixtures.existingNode, "init-existing-node")
    let denoChanges = Gen.scope(ws, fixtures.existingDeno, "init-existing-deno", runtime: "deno")
    let bunChanges = Gen.scope(ws, fixtures.existingBun, "init-existing-bun", runtime: "bun")

    # Existing user files should be modified (merged), not added fresh.
    Asserts.modified(nodeChanges, fixtures.existingNode + "/package.json")
    Asserts.modified(nodeChanges, fixtures.existingNode + "/tsconfig.json")
    Asserts.notAdded(
      nodeChanges,
      fixtures.existingNode + "/package.json",
      "package.json should not be reported as added when it already existed",
    )
    Asserts.notAdded(
      nodeChanges,
      fixtures.existingNode + "/tsconfig.json",
      "tsconfig.json should not be reported as added when it already existed",
    )

    let mergedPkg = nodeChanges.layer.file(fixtures.existingNode + "/package.json").contents
    Asserts.stringContains(mergedPkg, "\"name\": \"user-pkg\"", "user-authored name key should be preserved")
    Asserts.stringContains(mergedPkg, "\"version\": \"1.2.3\"", "user-authored version key should be preserved")
    Asserts.stringContains(mergedPkg, "\"build\": \"tsc\"", "user-authored script should be preserved")
    Asserts.stringContains(mergedPkg, "\"type\": \"module\"", "Dagger-required type=module should be added")
    Asserts.stringNotContains(
      mergedPkg,
      "\"@dagger.io/dagger\"",
      "legacy in-tree @dagger.io/dagger devDependency should be stripped",
    )

    let mergedTsConfig = nodeChanges.layer.file(fixtures.existingNode + "/tsconfig.json").contents
    Asserts.stringContains(mergedTsConfig, "\"target\": \"ES2020\"", "user-authored compiler target should be preserved")
    Asserts.stringContains(mergedTsConfig, "\"strict\": true", "user-authored strict flag should be preserved")
    Asserts.stringContains(mergedTsConfig, "\"@user/lib\"", "user-authored path mapping should be preserved")
    Asserts.stringContains(
      mergedTsConfig,
      "\"experimentalDecorators\": true",
      "Dagger-required experimentalDecorators should be added",
    )
    Asserts.stringContains(mergedTsConfig, "\"@dagger.io/dagger\"", "Dagger SDK path mapping should be added")
    Asserts.stringContains(
      mergedTsConfig,
      "\"@dagger.io/dagger/telemetry\"",
      "Dagger telemetry path mapping should be added",
    )

    Asserts.modified(denoChanges, fixtures.existingDeno + "/deno.json")
    Asserts.notAdded(
      denoChanges,
      fixtures.existingDeno + "/deno.json",
      "deno.json should not be reported as added when it already existed",
    )

    let mergedDeno = denoChanges.layer.file(fixtures.existingDeno + "/deno.json").contents
    Asserts.stringContains(mergedDeno, "\"dev\": \"deno run main.ts\"", "user-authored deno task should be preserved")
    Asserts.stringContains(mergedDeno, "\"@user/lib\"", "user-authored deno import should be preserved")
    Asserts.stringContains(mergedDeno, "\"kv\"", "user-authored unstable flag should be preserved")
    Asserts.stringContains(mergedDeno, "\"@dagger.io/dagger\"", "Dagger SDK import should be added")
    Asserts.stringContains(mergedDeno, "\"nodeModulesDir\": \"auto\"", "Dagger-required nodeModulesDir should be added")
    Asserts.stringContains(
      mergedDeno,
      "\"experimentalDecorators\": true",
      "Dagger-required experimentalDecorators should be added",
    )
    Asserts.stringContains(mergedDeno, "\"bare-node-builtins\"", "Dagger-required unstable flag should be appended")

    # bun init should not overwrite or add an existing bun.lock; the fixture's
    # lockfile content is non-JSON so any "merge" would corrupt it.
    Asserts.notAdded(
      bunChanges,
      fixtures.existingBun + "/bun.lock",
      "existing bun.lock should not be reported as added",
    )
    Asserts.assert(
      Asserts.contains(bunChanges.modifiedPaths, fixtures.existingBun + "/bun.lock") == false,
      "existing bun.lock should not be modified",
    )

    null
  }

  """
  Seeding a directory that already holds files should layer the starter onto it,
  never replace it: a user running `dagger module init` inside an existing
  project keeps everything that was already there.
  """
  initOverExistingCheck(ws: Workspace!): Void @check {
    let path = fixtures.existingNode
    let changes = Gen.scope(ws, path, "init-over-existing")

    Asserts.assert(
      changes.removedPaths.length == 0,
      "seeding removed existing files: " + changes.removedPaths.join(", "),
    )
    Asserts.stringContains(
      changes.after.file(path + "/package.json").contents,
      "\"name\": \"user-pkg\"",
      "seeding must leave the existing project files in place",
    )
    Asserts.stringContains(
      changes.after.file(path + "/src/index.ts").contents,
      "export class InitOverExisting",
      "seeding did not render the template into the existing directory",
    )

    null
  }

  """
  Init flags should write configuration into the generated config files. By
  default, no config keys are written; the runtime decides which file the
  base image override lands in.
  """
  initConfigCheck(ws: Workspace!): Void @check {
    let configuredPath = fixtures.out + "/init-configured"
    let configuredDenoPath = fixtures.out + "/init-configured-deno"
    let defaultPath = fixtures.out + "/init-config-default"

    let configured = Gen.scope(
      ws,
      configuredPath,
      "init-configured",
      packageManager: "pnpm@8.15.4",
      baseImage: "node:23.2.0-alpine",
    )
    let pkg = configuredPath + "/package.json"
    Asserts.added(configured, pkg)
    Asserts.assert(configured.removedPaths.length == 0, "configured init should not remove files")
    Asserts.stringContains(configured.layer.file(pkg).contents, "pnpm@8.15.4", "init --package-manager not written")
    Asserts.stringContains(configured.layer.file(pkg).contents, "node:23.2.0-alpine", "init --base-image not written")

    # Deno init with baseImage routes to deno.json; no package.json is created.
    let configuredDeno = Gen.scope(
      ws,
      configuredDenoPath,
      "init-configured-deno",
      runtime: "deno",
      baseImage: "denoland/deno:alpine-2.0.0",
    )
    let denoFile = configuredDenoPath + "/deno.json"
    Asserts.added(configuredDeno, denoFile)
    Asserts.stringContains(
      configuredDeno.layer.file(denoFile).contents,
      "denoland/deno:alpine-2.0.0",
      "init deno --base-image not written",
    )
    Asserts.notAdded(
      configuredDeno,
      configuredDenoPath + "/package.json",
      "deno init should not generate package.json even with baseImage",
    )

    # Default init has no config keys.
    let default = Gen.scope(ws, defaultPath, "init-config-default")
    let defaultPkg = defaultPath + "/package.json"
    Asserts.added(default, defaultPkg)
    Asserts.stringNotContains(
      default.layer.file(defaultPkg).contents,
      "packageManager",
      "default init should not write packageManager",
    )
    Asserts.stringNotContains(
      default.layer.file(defaultPkg).contents,
      "baseImage",
      "default init should not write baseImage",
    )

    null
  }

  """
  Seeding should reject what it cannot honor instead of writing a
  half-configured module: a template it does not ship, and a packageManager on a
  runtime that bundles its own.

  Path validation is not here any more — the engine resolves and validates the
  scope before it ever calls the SDK.
  """
  initRejectsCheck(ws: Workspace!): Void @check {
    Asserts.stringContains(
      Gen.failure(
        Gen.scope(ws, fixtures.out + "/init-unknown", "unknown", template: "no-such-template"),
      ),
      "unknown init template",
      "init accepted a template it does not ship",
    )

    Asserts.stringContains(
      Gen.failure(
        Gen.scope(ws, fixtures.out + "/init-pm-on-deno", "pm-on-deno", runtime: "deno", packageManager: "pnpm@8.15.4"),
      ),
      "packageManager is only supported",
      "init accepted --package-manager on a runtime that bundles its own",
    )

    null
  }

  """
  An unknown runtime should be rejected by name. The setting is a string rather
  than an enum, so a typo is only caught here.
  """
  initRejectsRuntimeCheck(ws: Workspace!): Void @check {
    Asserts.stringContains(
      Gen.failure(Gen.scope(ws, fixtures.out + "/init-bad-runtime", "bad-runtime", runtime: "nope")),
      "unknown runtime",
      "seeding accepted a runtime this SDK cannot generate for",
    )

    null
  }
}
