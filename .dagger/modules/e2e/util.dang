"""
Assertions shared by the e2e checks.
"""
type Asserts {
  """
  Fail the current check when a condition is false.
  """
  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Return true when a list contains the exact string.
  """
  let contains(values: [String!]!, want: String!): Boolean! {
    values
      .filter { value => value == want }
      .length > 0
  }

  """
  Assert that a changeset added a path.
  """
  let added(changes: Changeset!, path: String!): Void {
    assert(contains(changes.addedPaths, path), "expected added path: " + path)
  }

  """
  Assert that a changeset did not add a path.
  """
  let notAdded(changes: Changeset!, path: String!, message: String!): Void {
    assert(contains(changes.addedPaths, path) == false, message)
  }

  """
  Assert that a changeset modified a path.
  """
  let modified(changes: Changeset!, path: String!): Void {
    assert(contains(changes.modifiedPaths, path), "expected modified path: " + path)
  }

  """
  Assert that a changeset produced a path — added on a fresh tree, or modified
  when the output already exists (e.g. from a prior `dagger generate`).
  """
  let generated(changes: Changeset!, path: String!): Void {
    assert(
      contains(changes.addedPaths, path) or contains(changes.modifiedPaths, path),
      "expected generated (added or modified) path: " + path,
    )
  }

  """
  Assert that a string contains a substring.
  """
  let stringContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want), message)
  }

  """
  Assert that a string does not contain a substring.
  """
  let stringNotContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want) == false, message)
  }

  """
  Assert that a changeset touched exactly one file, the named one (no adds, no
  removes) — the shape a config edit must have.
  """
  let onlyFileChanged(changes: Changeset!, path: String!, message: String!): Void {
    assert(contains(changes.modifiedPaths, path), message + ": did not modify " + path)
    assert(changes.modifiedPaths.length == 1, message + ": modified more than one file")
    assert(changes.addedPaths.length == 0, message + ": should not add files")
    assert(changes.removedPaths.length == 0, message + ": should not remove files")
  }

  """
  Fail unless a result holds exactly the wanted paths, in any order.
  """
  let paths(got: [String!]!, want: [String!]!, context: String!): Void {
    let rendered = context + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]"

    assert(got.length == want.length, rendered)
    want.each { path => assert(contains(got, path), rendered) }
    null
  }
}

"""
Drives the SDK's scope generator the way the engine does, so checks exercise the
real entry point rather than the helpers behind it.
"""
type Gen {
  """
  Generate one scope and return the changes it makes to `ws`.

  The engine sets the workspace cwd to the scope before calling generateScope and
  diffs the workspace that comes back, so a check has to do both to see what a
  real run would write. The result is re-anchored at the caller's cwd, so
  assertions keep using workspace-root-relative fixture paths.

  Settings are constructor arguments, so a check covering the bun runtime or the
  empty template constructs the SDK with them — which is exactly what the engine
  does with a scope's effective settings.
  """
  let scope(
    ws: Workspace!,
    path: String!,
    name: String!,
    isModule: Boolean! = true,
    clients: [ModuleSource!]! = [],
    runtime: String! = "",
    template: String! = "default",
    packageManager: String! = "",
    baseImage: String! = "",
  ): Changeset! {
    typescriptSdk(
      runtime: runtime,
      template: template,
      packageManager: packageManager,
      baseImage: baseImage,
    )
      .generateScope(ws.withWorkdir(path), isModule: isModule, name: name, clients: clients)
      # withWorkdir sets the cwd from the workspace root, so "." puts the result
      # back where the caller stands and assertions keep using root-relative
      # fixture paths.
      .withWorkdir(".")
      .changes(ws.withWorkdir("."))
  }

  """
  Generate a module scope with the default settings.
  """
  let module(ws: Workspace!, path: String!, name: String!): Changeset! {
    scope(ws, path, name)
  }

  """
  A workspace with the deps fixture's dependency already generated.

  A module's schema only loads once its dependencies carry their committed
  generated files, and nothing stages them any more: the engine orders scopes so
  a dependency is generated first and threads the result into the next call. A
  check generating one scope on its own has to do that threading itself.
  """
  let withDependency(ws: Workspace!): Workspace! {
    ws.withChanges(module(ws, Fixtures.depLibModule, "gendep"))
  }

  """
  Return the error a rejected generation raised, or the paths it added when it
  unexpectedly succeeded.
  """
  let failure(changes: Changeset!): String! {
    changes.addedPaths.join(", ") rescue {
      err: Error => err.message
    }
  }
}

"""
Workspace-root-relative paths of the e2e fixture tree.

Checks address fixtures from the workspace root rather than through
`currentModule.source`, because the SDK functions under test take a Workspace
and resolve everything against its root.
"""
type Fixtures {
  let root: String! = ".dagger/modules/e2e/fixtures"

  """
  Where init checks stage their output. Nothing is ever written here — init
  returns a Changeset that the checks inspect — so these paths only have to be
  free of real files.
  """
  let out: String! = ".dagger/modules/e2e/out"

  # Legacy dagger.json modules used for find-up resolution.
  let lookupModule: String! = root + "/lookup/app"
  let lookupNested: String! = lookupModule + "/nested"
  let nonTsModule: String! = root + "/lookup/not-ts"

  # A module carrying the generate skip marker.
  let skipModule: String! = root + "/skip/app"

  # The one fixture `dagger generate` really regenerates.
  let generateModule: String! = root + "/generate/app"

  # A module whose dagger.json declares local dependencies in every supported
  # spelling (bare string, {name, source}, {source}).
  let depsModule: String! = root + "/deps/app"

  # A CLI 1.0 managed module: configured by dagger-module.toml, not dagger.json.
  let managedTomlModule: String! = root + "/managed-toml/app"

  # A dagger-module.toml module and the local dagger-module.toml dependency it
  # imports; both are workspace-managed, so generate-all covers the closure.
  let depAppModule: String! = root + "/generate-deps/app"
  let depLibModule: String! = root + "/generate-deps/dep"

  # The same edge in the legacy format: a dagger.json module with a local
  # dagger.json dependency. Generation routes to the engine here, and its
  # dependency staging is what a changeset must not carry back.
  let legacyDepAppModule: String! = root + "/generate-legacy-deps/app"
  let legacyDepLibModule: String! = root + "/generate-legacy-deps/dep"

  # Module config in <root>/.dagger/modules/app, implementation source in
  # <root>/ci — the split layout `dagger setup` migration produces.
  let parentSourceRoot: String! = root + "/parent-source"
  let parentSourceModule: String! = parentSourceRoot + "/.dagger/modules/app"
  let parentSourceCode: String! = parentSourceRoot + "/ci"

  # Directories that already hold user-authored config when init runs.
  let existingNode: String! = root + "/init-existing/node-app"
  let existingDeno: String! = root + "/init-existing/deno-app"
  let existingBun: String! = root + "/init-existing/bun-app"

  # Modules covering each config-read shape: unset, fully configured, Deno, and
  # no config file at all.
  let configModule: String! = root + "/config/app"
  let configuredModule: String! = root + "/config/configured"
  let configuredDenoModule: String! = root + "/config/configured-deno"

  """
  A Deno module managed by this SDK: exercises the one branch in generation
  that depends on the runtime, deno.json instead of package.json + tsconfig.
  """
  let denoModule: String! = root + "/generate-deno/app"

  """
  The runtime execution fixtures, managed so `dagger generate` keeps them
  current, and registered by the engine when the runtimes module loads them.
  """
  let runtimeBun: String! = ".dagger/modules/runtimes/fixtures/bun"
  let runtimeDeno: String! = ".dagger/modules/runtimes/fixtures/deno"
  let runtimeNode: String! = ".dagger/modules/runtimes/fixtures/node"
  let runtimeFixtures: [String!]! = [runtimeBun, runtimeDeno, runtimeNode]
  let configBareModule: String! = root + "/config/bare"

  # A client binds to client/app (which depends on client/dep) and is generated
  # into its own directory.
  let clientModule: String! = root + "/client/app"
  let clientOutput: String! = root + "/client/out"

  # A client directory that already points @dagger.io/dagger at a local bundle;
  # regeneration must preserve it.
  let clientExisting: String! = root + "/client/existing"

  """
  The module scopes this workspace records under [sdks.typescript.scopes], minus
  the two behind a skip marker.

  Mirrors dagger.toml by hand: a check cannot read the scope list back out of the
  engine, so this is the copy that has to be kept in step — and the check that
  generates every one of them is what catches it drifting.
  """
  let managedScopes: [ManagedScope!]! = [
    ManagedScope(path: depLibModule, name: "gendep"),
    ManagedScope(path: depAppModule, name: "generate-deps-app"),
    ManagedScope(path: denoModule, name: "generate-deno-app"),
    ManagedScope(path: runtimeBun, name: "runtime-bun"),
    ManagedScope(path: runtimeDeno, name: "runtime-deno"),
    ManagedScope(path: runtimeNode, name: "runtime-node"),
  ]

  """
  Every fixture configured by dagger-module.toml, including the skipped ones.
  These name an engine release, so they are the ones that can drift from the
  release this SDK's bundle is built for.
  """
  let managedTomlFixtures: [String!]! = [
    managedTomlModule,
    depAppModule,
    depLibModule,
    denoModule,
    parentSourceModule,
  ] + runtimeFixtures
}

"""
One module scope recorded in the workspace config.
"""
type ManagedScope {
  """
  Workspace-root-relative path of the scope.
  """
  let path: String!

  """
  The scope's recorded name, which the engine passes to every generation.
  """
  let name: String!
}
