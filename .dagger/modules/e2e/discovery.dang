"""
Checks for `typescriptSdk.detectScope` — which directory this SDK claims as the
project containing the workspace cwd.

Detection replaces the engine-owned module list the beta interface handed us.
The engine asks every installed SDK where the cwd belongs and takes the deepest
answer, so this decides both which scope a `dagger module client add` lands in
and whether TypeScript owns it at all.
"""
type DiscoveryChecks {
  let fixtures: Fixtures! = Fixtures

  """
  A workspace built from nothing but the named files, anchored at `cwd`.

  Synthetic rather than a slice of the real tree: detection answers a question
  about the files above the cwd, so a fixture that spells out exactly those files
  is the only way to pin the answer down.
  """
  let workspaceWith(files: [String!]!, cwd: String!): Workspace! {
    files
      .reduce(directory) { dir, path => dir.withNewFile(path, "{}") }
      .asWorkspace(cwd: cwd)
  }

  """
  The scope this SDK detects from `cwd` in a workspace holding `files`.
  """
  let detected(files: [String!]!, cwd: String!): String! {
    typescriptSdk.detectScope(workspaceWith(files, cwd))
  }

  """
  Every marker should mark a project root, and the directory holding it is the
  scope. A TypeScript project is a package.json for Node and Bun, a deno.json
  for Deno; a bare tsconfig.json covers a project that is neither.
  """
  detectMarkersCheck: Void @check {
    Asserts.assert(
      detected(["apps/web/package.json"], "apps/web") == "apps/web",
      "package.json should mark a scope",
    )
    Asserts.assert(
      detected(["apps/web/deno.json"], "apps/web") == "apps/web",
      "deno.json should mark a scope",
    )
    Asserts.assert(
      detected(["apps/web/deno.jsonc"], "apps/web") == "apps/web",
      "deno.jsonc should mark a scope",
    )
    Asserts.assert(
      detected(["apps/web/tsconfig.json"], "apps/web") == "apps/web",
      "tsconfig.json should mark a scope",
    )

    null
  }

  """
  Detection walks up: standing anywhere inside a project resolves to the project
  root, which is what lets `dagger module client add` work from a subdirectory.
  """
  detectFindsUpCheck: Void @check {
    Asserts.assert(
      detected(["apps/web/package.json", "apps/web/src/.keep"], "apps/web/src") == "apps/web",
      "detection should walk up to the nearest project root",
    )
    Asserts.assert(
      detected(["package.json", "apps/web/src/.keep"], "apps/web/src") == ".",
      "a project at the workspace root should be detected as the workspace root",
    )

    null
  }

  """
  The deepest marker wins, regardless of which filename found it.

  A monorepo has a package.json at the root and one per app; a client belongs to
  the app the user is standing in, not the repo. The engine compares SDKs by
  scope length too, so answering with an ancestor would also hand the scope to
  whichever SDK answered more precisely.
  """
  detectDeepestWinsCheck: Void @check {
    Asserts.assert(
      detected(["package.json", "apps/web/package.json"], "apps/web") == "apps/web",
      "the nearest project root should win over an ancestor",
    )
    # Mixed filenames: a nearer deno.json must not be shadowed by an ancestor's
    # package.json, or a Deno app inside a Node monorepo resolves to the wrong
    # scope.
    Asserts.assert(
      detected(["package.json", "apps/web/deno.json"], "apps/web") == "apps/web",
      "the deepest marker should win whichever filename found it",
    )

    null
  }

  """
  With no marker at or above the cwd, detection should decline.

  Returning "" is how the engine learns this SDK manages nothing here, so
  another SDK can claim the directory. Claiming it anyway would make every
  `dagger module client add` in a non-TypeScript tree ambiguous.
  """
  detectDeclinesCheck: Void @check {
    Asserts.assert(
      detected(["services/api/go.mod"], "services/api") == "",
      "detection should decline a directory with no TypeScript project",
    )
    # A marker *below* the cwd is not a project the cwd belongs to.
    Asserts.assert(
      detected(["apps/web/package.json", ".keep"], ".") == "",
      "a marker below the cwd should not be detected as its scope",
    )

    null
  }

  """
  Detection should agree with the real fixture tree, not just synthetic ones: a
  fixture that already carries user-authored config is a project root, and the
  migration-layout fixture's source tree is one too.
  """
  detectRealTreeCheck(ws: Workspace!): Void @check {
    Asserts.assert(
      typescriptSdk.detectScope(ws.withWorkdir(fixtures.existingNode)) == fixtures.existingNode,
      "a directory with a user package.json should be its own scope",
    )
    Asserts.assert(
      typescriptSdk.detectScope(ws.withWorkdir(fixtures.parentSourceCode)) == fixtures.parentSourceCode,
      "the migration fixture's source tree should be a scope of its own",
    )

    null
  }
}
