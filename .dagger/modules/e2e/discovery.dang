"""
Checks for `typescriptSdk.modules` — which managed modules are in scope.

Discovery intersects two things: the config directories the polyfill finds from
the client's cwd, and the engine-owned list of modules this SDK manages
(`currentModule.asSDK.modules`). So the workspace decides *what* is a module of
ours and the cwd decides *how much of it* a command acts on.
"""
type DiscoveryChecks {
  let fixtures: Fixtures! = Fixtures

  """
  Workspace-root-relative paths of every module discovered from `cwd`.
  """
  let discovered(ws: Workspace!, cwd: String!, extra: [String!]! = []): [String!]! {
    typescriptSdk
      .modules(fixtures.discoverySnapshot(ws, cwd, extra: extra))
      .{{rootPath}}
      .map { mod => mod.rootPath }
  }

  """
  Cwd-relative paths of every module discovered from `cwd` — how a listing reads
  to someone standing there.
  """
  let discoveredRelative(ws: Workspace!, cwd: String!, extra: [String!]! = []): [String!]! {
    typescriptSdk
      .modules(fixtures.discoverySnapshot(ws, cwd, extra: extra))
      .{{path}}
      .map { mod => mod.path }
  }

  """
  From the workspace root the whole workspace is in scope, so modules() should
  return every TypeScript SDK module this workspace manages — whether it is
  configured by the legacy dagger.json or the CLI 1.0 dagger-module.toml — and
  nothing that isn't managed by this SDK (e.g. a sibling module using another
  SDK).

  Runs against the real workspace, so it also catches a dagger.toml
  [[...as-sdk.modules]] entry that no longer matches the fixture tree.
  """
  modulesCheck(ws: Workspace!): Void @check {
    let roots = typescriptSdk.modules(ws).{{rootPath}}.map { mod => mod.rootPath }

    fixtures.managedModules.each { want =>
      Asserts.assert(Asserts.contains(roots, want), "managed module should be listed: " + want)
    }
    Asserts.assert(
      Asserts.contains(roots, fixtures.nonTsModule) == false,
      "a module not managed by this SDK should be excluded from modules listing",
    )

    null
  }

  """
  Discovery is anchored at the client's cwd, not the workspace root. Re-anchoring
  the workspace to a subdirectory scopes modules() to the managed modules in that
  cone (walk-down) plus the nearest enclosing one (find-up), and excludes managed
  modules that live outside it.
  """
  modulesCwdCheck(ws: Workspace!): Void @check {
    # Walk-down: from fixtures/generate only generate/app is in the cone; the
    # sibling managed modules live outside it and must be excluded. Its
    # cwd-relative path is "app" — a directory beneath the cwd.
    let generateCwd = fixtures.root + "/generate"
    Asserts.paths(discovered(ws, generateCwd), [fixtures.generateModule], "cwd=generate")
    Asserts.paths(discoveredRelative(ws, generateCwd), ["app"], "cwd=generate (cwd-relative)")

    # Find-up: from inside lookup/app (a nested subdir with no config of its own)
    # the enclosing managed module is discovered; siblings are not. Its
    # cwd-relative path is ".." — an ancestor of the cwd. The nested dir has no
    # config, so it needs its .keep to survive the snapshot filter.
    let keep = ["**/.keep"]
    Asserts.paths(
      discovered(ws, fixtures.lookupNested, extra: keep),
      [fixtures.lookupModule],
      "cwd=lookup/app/nested",
    )
    Asserts.paths(
      discoveredRelative(ws, fixtures.lookupNested, extra: keep),
      [".."],
      "cwd=lookup/app/nested (cwd-relative)",
    )

    # Root cwd: the whole workspace is in scope, so exactly the managed modules
    # are discovered, whether marked by dagger.json or dagger-module.toml.
    Asserts.paths(discovered(ws, "/"), fixtures.managedModules, "cwd=/")

    null
  }

  """
  A module whose config `source` points outside its own directory is discovered
  through the directory holding that config, not through the directory holding
  its code.

  That is the layout `dagger setup` migration writes: config in
  .dagger/modules/<name>/, source pointing back at the pre-existing code (here
  ci/). Standing at the project root finds it; standing in ci/ does not, because
  ci/ holds no module config and nothing above it does either. Callers who want
  to act on the module from its source tree address it by path instead.
  """
  parentSourceDiscoveryCheck(ws: Workspace!): Void @check {
    # From the project root, the module config is in the walk-down cone and the
    # module is reported at that config path, not at its source path.
    Asserts.paths(
      discovered(ws, fixtures.parentSourceRoot),
      [fixtures.parentSourceModule],
      "cwd=parent-source",
    )
    Asserts.paths(
      discoveredRelative(ws, fixtures.parentSourceRoot),
      [".dagger/modules/app"],
      "cwd=parent-source (cwd-relative)",
    )

    # From the source tree, there is no module config at or above the cwd that
    # this SDK manages, so nothing is in scope.
    Asserts.paths(
      discovered(ws, fixtures.parentSourceCode, extra: [fixtures.parentSourceCode + "/package.json"]),
      [],
      "cwd=parent-source/ci",
    )

    null
  }
}
