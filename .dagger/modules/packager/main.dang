"""
Builds the TypeScript SDK library artifacts this repo ships.

The SDK module reads them straight off its own source at generate time, so
whatever this produces has to be committed. Everything lands under `library/`,
laid out the way the library source expects it, and is refreshed by
`dagger generate`.
"""
type Packager {
  """
  Workspace-relative directory holding the library.
  """
  let libraryPath: String! = "library"

  """
  Directory holding the library's own generated bindings, relative to
  libraryPath. They reach the runtime through @dagger.io/session — the package
  they will be published alongside — a specifier that resolves through the
  workspace symlink here and through the registry once published, so nothing
  has to be rewritten at packaging time.
  """
  let bindingsPath: String! = "src/core"

  """
  Regenerate the TypeScript library's own bindings (client.gen.ts) from the
  running engine's schema.

  The schema comes from the session rather than from a module: a plain session
  serves no modules, so introspecting it yields the core API alone — which is
  exactly what a library binds. That one step is why this opens a nested
  session; rendering the bindings from the resulting JSON does not.
  """
  libraryBindings(ws: Workspace!): Changeset! @generate {
    let bindings = codegen(ws)
      .withExec(["codegen", "introspect", "--output", "/schema.json"], experimentalPrivilegedNesting: true)
      .withExec(["codegen", "library", "--introspection-json-path", "/schema.json", "--output", "/out"])
      .directory("/out")

    # Stage over the directory's existing contents, not in place of them:
    # withNewDirectory swaps the whole directory, so staging only what codegen
    # emits reports everything else there — the .gitattributes marking these
    # bindings as generated — as deleted.
    let target = "/" + libraryPath + "/" + bindingsPath
    ws.withNewDirectory(target, ws.directory(target).withDirectory(".", bindings)).changes(ws)
  }

  """
  Build the bundled library the generated module bindings import as ./core.js.

  Same recipe and same pinned image as the engine's own build
  (toolchains/engine-dev/build/sdk.go), so a module built against this bundle
  behaves like one built against the engine's: a single node-targeted JS bundle
  with the TypeScript compiler left external, plus the rolled-up type
  declarations for it.

  The install is frozen against the committed bun.lock. Both lockfiles matter and
  neither is redundant: yarn.lock is what the vendored sources came with, and
  dropping it lets resolution pull newer transitives that grow core.js by roughly
  a quarter (4.3 MB -> 5.4 MB); but it is a yarn v1 file that does not pin
  everything bun resolves, so without bun.lock a rebuild days later can still
  drift — observed as a bundle quietly gaining transitive modules on an unchanged
  tree. Freezing makes that drift a failed install instead of a silent diff.
  """
  libraryBundle(ws: Workspace!): Changeset! @generate {
    let built = bun
      .withDirectory("/src", ws.directory("/" + libraryPath))
      .withWorkdir("/src")
      .withExec(["bun", "install", "--frozen-lockfile"])
      # The facade imports the four layers as packages, which resolve through
      # the workspace symlinks to each layer's dist/ — so the layers are built
      # before anything bundles them. tsc -b follows the project references, so
      # session comes first without being named.
      .withExec(["bun", "x", "tsc", "-b", "src/core", "src/module", "src/telemetry"])
      .withExec(["bun", "build", "./src/index.ts", "--external=typescript", "--target=node", "--outfile", "/out/core.js"])
      # `bun x`, not a global tsc: the declarations we ship have to come from the
      # compiler the lockfile pins, the same one typescript-version.txt records
      # below. A globally installed tsc is whatever the registry served that day,
      # so core.d.ts could move on an unchanged tree.
      .withExec(["bun", "x", "tsc", "--emitDeclarationOnly"])
      .withExec(["bun", "x", "rollup", "-c", "rollup.dts.config.mjs", "-o", "/out/core.d.ts"])
      # The scanner module codegen runs over a user's source. Bundled rather
      # than `bun build --compile`d as the engine does: a compiled binary is
      # ~100MB and per-platform, where this is a few MB of portable JS.
      .withExec([
        "bun", "build", "src/module/introspector/introspection_entrypoint.ts",
        "--external=typescript", "--target=node", "--outfile", "/out/introspector.js",
      ])
      # The import scanner, which derives a module's resources from what its
      # source imports. Its own bundle rather than a mode of the scanner above:
      # it runs *before* that one, to work out which files have to be in the
      # tree the scan reads, and it needs none of the typedef machinery.
      .withExec([
        "bun", "build", "src/module/introspector/imports_entrypoint.ts",
        "--external=typescript", "--target=node", "--outfile", "/out/imports.js",
      ])
      # The scanner reads the user's code through the TypeScript compiler API,
      # which stays external to its bundle. The compiler is not shipped here —
      # it is a build-time dependency of ours (a different version from the one
      # a module declares for its own runtime), so codegen installs it instead
      # of this repo carrying 9MB of third-party blob per engine bump. Record
      # which version to install, derived from the vendored lockfile so
      # re-vendoring cannot silently move the scanner off the API it was
      # written against.
      .withExec(["sh", "-c",
        "node -p \"require('./node_modules/typescript/package.json').version\" > /out/typescript-version.txt"])
      # The engine release the library announces, for the SDK: its own pairing
      # is whatever the bundle it ships was built to announce.
      .withExec(["sh", "-c",
        "bun -e \"import('./src/session/provisioning/engineVersion.ts').then(m => console.log(m.ENGINE_VERSION))\" > /out/engine-version.txt"])
      .directory("/out")

    # Same overlay as the bindings: the bundle directory also holds the
    # hand-written index.ts and telemetry.ts wrappers, which this build does not
    # produce and a straight directory swap would report as deleted.
    let target = "/" + libraryPath + "/" + bundlePath
    ws.withNewDirectory(target, ws.directory(target).withDirectory(".", built)).changes(ws)
  }

  """
  Directory holding the built bundle, relative to libraryPath. Committed: the
  SDK module reads it at generate time, and building it there would put a bun
  toolchain in every user's `dagger generate`.
  """
  let bundlePath: String! = "bundle"

  """
  The four layers built as packages, each into its own dist/.

  `tsc -b` over the per-layer tsconfigs, which reference each other, so the build
  order falls out of the references rather than being spelled here. One container
  for all four because they share an install and a compiler.
  """
  let packagesBuilt(ws: Workspace!): Container! {
    bun
      .withDirectory("/src", ws.directory("/" + libraryPath))
      .withWorkdir("/src")
      .withExec(["bun", "install", "--frozen-lockfile"])
      .withExec(["bun", "x", "tsc", "-b", "src/core", "src/module", "src/telemetry"])
  }

  """
  The scripts that check and stamp a package manifest, mounted together because
  audit-imports.cjs requires imports.cjs beside it.
  """
  let packageTools: Directory! {
    directory
      .withFile("imports.cjs", currentModule.source.file("imports.cjs"))
      .withFile("audit-imports.cjs", currentModule.source.file("audit-imports.cjs"))
      .withFile("release-version.cjs", currentModule.source.file("release-version.cjs"))
      .withFile("await-published.cjs", currentModule.source.file("await-published.cjs"))
  }

  """
  The layers that ship as packages of their own, published from this repo.

  `core` is absent on purpose: it is generated against an engine release and
  published from dagger/dagger, so its version is the engine's rather than this
  repo's. It is still built here, because the facade and the bundle import it.
  """
  publishedLayers: [String!]! {
    ["session", "module", "telemetry"]
  }

  """
  Every layer built as a package here, including the one this repo does not
  release.

  `core` is published from dagger/dagger, but it is *built* here — so it is this
  repo's job to know the tarball is sound. Nothing installed it until a relative
  import out of `core.ts` emitted into `core/dist/core.js` as
  `../session/context.js`, resolving inside the package to nothing at all, and no
  check noticed.
  """
  builtLayers: [String!]! {
    ["session", "core", "module", "telemetry"]
  }

  """
  One layer, built and ready to `npm publish`.

  The package is what sits in library/src/<layer>: its committed package.json
  and the dist/ its own tsconfig emits. The only thing added is the version. The
  manifests carry the version last released from here, and pin their siblings at
  it, so the tree records what is out rather than a placeholder. It is not what
  ships: release-version.cjs stamps on whatever a release passes, moving the
  sibling pins with it so `session` and the packages over it only ever ship
  together.
  """
  publishablePackage(
    ws: Workspace!,
    layer: String!,
    version: String! = "0.0.0",
  ): Directory! {
    let pkg = "/src/src/" + layer
    let built = packagesBuilt(ws)
      .withDirectory("/tools", packageTools)
      .withEnvVariable("PUBLISH_VERSION", version)
      .withExec(["node", "/tools/release-version.cjs", pkg + "/package.json", "/manifest.json"])

    directory
      .withDirectory("dist", built.directory(pkg + "/dist"))
      .withFile("package.json", built.file("/manifest.json"))
  }

  """
  Release every layer this repo publishes: stage them under `next`, wait for the
  registry to serve them, import them, and only then move `latest`.

  The ordering is the point, and it is not arbitrary. `npm publish` resolves
  nothing, so staging cannot fail on a sibling that is not fetchable yet — a
  release can only break a *consumer*, seconds later. So nothing gates the publish
  and everything gates the flip: if the wait or the import never passes, `latest`
  never moves and no consumer saw the version. That is worth the machinery because
  `npm unpublish` is restricted to 72 hours and refuses outright once anything
  depends on a version. After that `npm deprecate` is the only recourse.

  `registry` is what makes this rehearsable rather than a thing you run once and
  hope: point it at a local verdaccio and the whole sequence runs against that.
  `e2e:registry/release-rehearsal-check` does exactly that, over these same three
  steps.

  The one case this cannot stage is the **first** publish of a package name. A
  registry has to give a new package a `latest`, so `--tag next` sets both. There
  is nothing to stage away from either, since nobody installs a name that did not
  exist until now. See design/package-split.md.

  `registryService` and `registryAlias` are only for pointing this at a registry
  running as a Dagger service, which is how the check exercises it; a registry
  that is reachable on its own needs neither.
  """
  release(
    ws: Workspace!,
    version: String!,
    token: Secret!,
    registry: String! = "https://registry.npmjs.org",
    registryService: Service = null,
    registryAlias: String! = "",
  ): String! {
    let specs = publishedLayers.map { layer => "@dagger.io/" + layer + "@" + version }

    let client = releaseClient(token, registry, registryService, registryAlias)

    let staged = publishedLayers.reduce(client) { chain, layer =>
      chain
        .withDirectory("/publish/" + layer, publishablePackage(ws, layer, version: version))
        .withWorkdir("/publish/" + layer)
        # Tolerated so a release is resumable: if the flip failed last time, the
        # versions are already up and the retry has to get past this to redo the
        # part that matters. Nothing is lost by it either — the design forbids
        # mutating a published version, so a conflict means "already staged", and
        # await-published below is what decides whether that is actually true.
        # --access public because these are scoped names and npm defaults a scope
        # to restricted. Without it the first publish of each either fails or
        # quietly creates a private package. No local registry can catch this:
        # verdaccio ignores the flag entirely.
        .withExec(["npm", "publish", "--tag", "next", "--access", "public"], expect: ANY)
    }

    let verified = staged
      .withWorkdir("/smoke")
      .withExec(["node", "/tools/await-published.cjs", registry] + specs)
      # Packing the tarballs left this npm holding what it just read, so without
      # this the install is answered from its own cache rather than by the
      # registry the release is being judged on.
      .withExec(["npm", "cache", "clean", "--force"])
      .withExec(["npm", "install", "--no-audit", "--no-fund"] + specs)
      .withExec(["node", "/smoke/smoke.mjs"])

    let flipped = publishedLayers.reduce(verified) { chain, layer =>
      chain.withExec(["npm", "dist-tag", "add", "@dagger.io/" + layer + "@" + version, "latest"])
    }

    let listed = publishedLayers.reduce(flipped) { chain, layer =>
      chain.withExec(
        ["npm", "dist-tag", "ls", "@dagger.io/" + layer],
        redirectStdout: "/tags/" + layer,
      )
    }

    publishedLayers.map { layer =>
      "@dagger.io/" + layer + "\n" + listed.file("/tags/" + layer).contents
    }.join("\n")
  }

  """
  A node container authenticated against the registry, with the smoke test and
  the tools already in it.

  The token reaches npm as a secret and is never written anywhere: npm expands
  `${NPM_TOKEN}` in .npmrc itself, so the file holds the name and not the value.
  """
  let releaseClient(
    token: Secret!,
    registry: String!,
    registryService: Service,
    registryAlias: String!,
  ): Container! {
    let base = container
      .from("node:24-alpine")
      .withoutEntrypoint
      # HOME explicitly, because .npmrc is looked up under it.
      .withEnvVariable("HOME", "/root")
      .withSecretVariable("NPM_TOKEN", token)
      .withNewFile("/root/.npmrc", releaseNpmrc(registry))
      .withNewFile("/smoke/package.json", "{ \"type\": \"module\" }\n")
      .withNewFile("/smoke/smoke.mjs", smokeSource)
      .withDirectory("/tools", packageTools)
      .withExec(["mkdir", "-p", "/tags"])

    if (registryService == null) {
      base
    } else {
      base.withServiceBinding(registryAlias, registryService)
    }
  }

  """
  npm's configuration for a release: every resolution through the registry under
  test, and the auth line keyed on its host the way npm keys it.
  """
  let releaseNpmrc(registry: String!): String! {
    let host = registry.trimPrefix("https://").trimPrefix("http://").trimSuffix("/")

    "registry=" + registry + "\n" +
      "//" + host + "/:_authToken=${NPM_TOKEN}\n"
  }

  """
  Imports every layer released here, from the registry rather than from the tree.

  Deliberately thin. This answers the resolve-and-load question — the one a
  consumer hits first, and the one `npm publish` cannot answer because it resolves
  nothing. Whether the library *works* is what the test suite is for, and it ran
  long before anything was packed.
  """
  let smokeSource: String! {
    "import { Context } from \"@dagger.io/session\"\n" +
      "import { object } from \"@dagger.io/module\"\n" +
      "import { getTracer } from \"@dagger.io/telemetry\"\n" +
      "\n" +
      "for (const [name, loaded] of Object.entries({ Context, object, getTracer })) {\n" +
      "  if (typeof loaded !== \"function\") {\n" +
      "    throw new Error(name + \" did not load: \" + typeof loaded)\n" +
      "  }\n" +
      "}\n" +
      "console.log(\"smoke ok\")\n"
  }

  """
  Each published manifest declares what its package imports, and nothing else.

  The manifests are hand-written, so this is where a dependency added to a layer
  but not to its manifest shows up — before a consumer installs the package and
  the import fails. It runs over the built package because that is JavaScript:
  `import type` is erased by then, and a type-only import is not a dependency.
  """
  manifestIsHonestCheck(ws: Workspace!): Void @check {
    publishedLayers.each { layer =>
      bun
        .withDirectory("/pkg", publishablePackage(ws, layer))
        .withDirectory("/tools", packageTools)
        .withExec(["node", "/tools/audit-imports.cjs", "/pkg"])
        .sync
    }

    null
  }

  """
  Bun toolchain the library is built with, pinned by digest. NodeJS comes along
  because the declaration build shells out to tsc.

  1.3.14, ahead of the 1.3.0 the engine builds its own bundle with. Not by
  choice: `bun install` in 1.3.0 does not link the workspace members under
  library/src into node_modules at all — 416 packages installed, none of them
  @dagger.io/* — so anything resolving the layers at runtime (the bundle, the
  test suite) fails with "Cannot find module '@dagger.io/telemetry'". 1.3.14
  links all four. Reproduced in both images on the same tree, with and without
  a private root.

  No TypeScript here: every step that needs a compiler takes the one the
  vendored lockfile resolves, so the image stays free of a version nothing pins.
  """
  let bun: Container! {
    container
      .from("oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0")
      .withoutEntrypoint
      .withExec(["apk", "add", "nodejs"])
  }

  """
  The module-facing bundle must not carry the TypeScript compiler.

  core.js is loaded on every module load, and the compiler is the single most
  expensive thing it can pull in: importing it costs roughly twice what the rest
  of the bundle costs, for something a running module never uses — the compiler
  is how the introspector reads a user's source at *generate* time, not how a
  module dispatches a call.

  It arrives transitively. Re-export anything that reaches the introspector from
  the bundle's entry and the whole scanner comes with it, which is why
  src/index.ts stops re-exporting the dynamic `entrypoint`. That is a local
  delta against a vendored file, so it is exactly the kind of thing a re-vendor
  drops on the floor — asserted here rather than trusted.
  """
  moduleBundleCheck(ws: Workspace!): Void @check {
    let core = ws.directory("/" + libraryPath + "/" + bundlePath).file("core.js").contents

    if (core.contains("from \"typescript\"")) {
      raise "library/bundle/core.js imports the TypeScript compiler; a module " +
        "loads this bundle on every call and does not need a compiler to " +
        "dispatch. Something re-exported from library/src/index.ts reaches the " +
        "introspector — see library/VENDOR.md."
    }

    null
  }

  """
  The library's manifest must resolve with npm, not only with bun.

  npm is the only one of the three installers that enforces `peerDependencies` at
  install time, so it is the only one that would have noticed
  `graphql-request@7.4.0` peering on `graphql "14 - 16"` while this manifest asked
  for `^17.0.1`. It did not notice, for as long as nobody ran npm over it: bun and
  yarn install that tree without a word, and both lockfiles here recorded it
  happily. A consumer on npm would have hit `ERESOLVE` on the first install.

  Nothing here is published yet, which is exactly why this check exists — it
  stands in for the consumer who will be. Production dependencies only: that is
  the closure a published package hands over, and the dev tools are bun's problem.

  `--dry-run` because resolution is the whole question; ERESOLVE happens before
  anything is downloaded.
  """
  manifestInstallsCheck(ws: Workspace!): Void @check {
    container
      .from("node:24-alpine")
      .withoutEntrypoint
      .withFile("/lib/package.json", ws.file("/" + libraryPath + "/package.json"))
      .withWorkdir("/lib")
      .withExec(["npm", "install", "--omit=dev", "--no-audit", "--no-fund", "--dry-run"])
      .sync

    null
  }

  """
  Every source file under `layer` that imports from any of `forbidden`,
  formatted as a line naming both ends of the edge.
  """
  let crossedLayerBoundaries(src: Directory!, layer: String!, forbidden: [String!]!): [String!]! {
    forbidden.reduce([]) { found, other =>
      found + src.glob(layer + "/**/*.ts")
        .filter { path => src.file(path).contents.contains("/" + other + "/") }
        .map { path => "  " + path + " imports " + other }
    }
  }

  """
  The library's layers do not import upward.

  The layering is session <- core <- module, which is the shape the package split
  needs: @dagger.io/core depends on @dagger.io/session, @dagger.io/module on
  @dagger.io/core. While it is all still one package nothing but this check stops
  an upward import being added — and the moment one is, the split stops being a
  packaging change and becomes a refactor again. See design/package-split.md.

  Checked on the source rather than the bundle: the bundle is one file with the
  layering flattened out of it, so by the time an upward import shows up there it
  is unattributable.

  No layer may reach `telemetry`, which is the rule that keeps the OpenTelemetry
  SDK out of a generated client's closure — roughly 96 MB of the 161 MB one
  installs today. `connection` needs both a session and the tracer's lifetime, so
  it is not in a layer at all: it sits beside `index.ts` as the composition it is,
  and the facade is the only package that will carry it.

  Files directly under `src/` are unchecked for that reason. They are the facade,
  and the facade is allowed to depend on everything — it is defined as the thing
  that does.
  """
  layeringCheck(ws: Workspace!): Void @check {
    let src = ws.directory("/" + libraryPath + "/src")

    let violations =
      crossedLayerBoundaries(src, "session", ["core", "module", "telemetry"]) +
      crossedLayerBoundaries(src, "core", ["module", "telemetry"]) +
      crossedLayerBoundaries(src, "module", ["telemetry"]) +
      crossedLayerBoundaries(src, "telemetry", ["session", "core", "module"])

    if (violations.length > 0) {
      raise "library/src crosses a layer boundary:\n" +
        violations.join("\n") +
        "\n\nLayering is session <- core <- module. See design/package-split.md."
    }

    null
  }

  """
  Run the vendored library's own test suite.

  Mostly the introspector's: it scans the fixture modules under testdata and
  compares the result against a recorded expectation. That is the contract
  entrypoint generation is built on — the scanner's output is what the
  dispatcher is rendered from — and nothing else here would notice it drifting,
  since our own golden pins the renderer given a typedef, not the typedef given
  a module.

  The specs that need a live session (invoke, registry, api, connect) are not
  vendored: they would need an engine inside this container, and what they cover
  is the library's runtime rather than anything this SDK generates.
  """
  libraryTests(ws: Workspace!): Void @check {
    bun
      .withDirectory("/src", ws.directory("/" + libraryPath))
      .withWorkdir("/src")
      .withExec(["bun", "install"])
      # The specs scan fixtures that reach the facade, and the facade resolves
      # the layers through their dist/ — see libraryBundle.
      .withExec(["bun", "x", "tsc", "-b", "src/core", "src/module", "src/telemetry"])
      .withExec(["bun", "run", "--bun", "mocha"])
      .sync

    null
  }

  """
  Container with the codegen helper compiled and on PATH at
  /usr/local/bin/codegen. Read from the workspace rather than this module's own
  source: the helper lives at the repo root, outside the module directory. The
  path is workspace-root-absolute, so generating from a subdirectory still
  finds it.
  """
  let codegen(ws: Workspace!): Container! {
    container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helper", ws.directory("/helpers/codegen"))
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/codegen", "."])
  }
}
