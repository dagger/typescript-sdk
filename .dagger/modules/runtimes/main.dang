"""
Execution checks: does a module this SDK generates actually run?

Every other check in this repo inspects what generation *writes*. These load
the result, which for a dagger-module.toml module means the engine builds the
runtime container and executes the generated entrypoint to discover its types —
there is no codegen at call time to paper over a bad tree.

That makes them the only checks covering the contract the whole move rests on:
sdk/ resolving as @dagger.io/dagger, the bundle it holds being loadable, the
entrypoint importing the user's classes and registering them. A break here is a
module that generates cleanly and then fails at `dagger call`.

One fixture per TypeScript runtime, because this is where they stop being
interchangeable: generation differs only in which config file it writes, but
node, bun and deno each run the entrypoint in a different container, with a
different interpreter, resolving @dagger.io/dagger a different way.
"""
type Runtimes {
  let fixtures: String! = ".dagger/modules/runtimes/fixtures"

  """
  A node module should generate and run.
  """
  nodeRunsCheck(ws: Workspace!): Void @check {
    assertRuns(ws, "node", "RuntimeNode")
  }

  """
  A bun module should generate and run.

  The engine picks bun over node by finding a lockfile next to package.json, so
  the generated tree is byte-identical to the node one — only the container it
  is executed in differs. Nothing else in this repo has ever run bun.
  """
  bunRunsCheck(ws: Workspace!): Void @check {
    assertRuns(ws, "bun", "RuntimeBun")
  }

  """
  A deno module should generate and run.

  Deno has no node_modules to fall back on: if generation writes the wrong
  config, the runtime cannot resolve @dagger.io/dagger at all.
  """
  denoRunsCheck(ws: Workspace!): Void @check {
    assertRuns(ws, "deno", "RuntimeDeno")
  }

  """
  A function that throws in an entrypoint module should fail with what it
  threw, as it does under the builtin runtime.

  The entrypoint runs the dispatcher in a container, so a thrown error used to
  reach the engine as the exec's "exit code: 1", its message only in the exec
  log. The dispatcher now replies with the error as data and the recipe raises
  it; this is the check that the message really comes out the other end.

  Exercised through a check because a check's result is the one thing a
  module's caller can read back without a typed client, and a check is a
  function call like any other on this path. The fixture is installed into the
  staged workspace for the same reason: artifacts are discovered from installed
  modules.
  """
  entrypointErrorTextCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/node"
    let installed = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-node", clients: [])
      .withWorkdir(".")
      .withModule(path, name: "runtime-node")

    let messages = installed.artifacts(include: ["runtime-node:failing-check"]).asChecks
      .{{ error.{{ message }} }}
      .map { c => c.error.message ?? "the check passed" }

    if (messages.length != 1) {
      raise "expected the fixture's one failing check, got " + toString(messages.length)
    }
    let message = messages.join("")
    if (message.contains("RuntimeNode failure: boom") == false) {
      raise "a thrown error should fail the call with its message, got: " + message
    }
    if (message.contains("exit code")) {
      raise "a thrown error should not surface as the dispatcher's exit code, got: " + message
    }

    null
  }

  """
  A secondary @object with a TypeScript constructor of its own should not stop
  an entrypoint module from loading, and should still round-trip.

  The engine identifies an entrypoint module's main object by its constructor
  typedef, so a second one anywhere in types() makes it reject the whole module
  with "multiple object constructors are not supported" — a normal shape (a
  value object the main object constructs) that no generated-file check can
  catch, because the file is written correctly as far as the SDK's own schema
  goes. Reading the module's objects is what trips it.

  The fixture's check hangs off RuntimeSecondary.note, so passing it also
  requires the constructor the typedef no longer declares: the engine calls
  note(), the dispatcher constructs RuntimeNote and serializes it, and the
  check reads the field back off the value the engine handed down.
  """
  secondaryConstructorRunsCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/secondary"
    let staged = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-secondary", clients: [])
      .withWorkdir(".")

    assertLoads(staged, path, "RuntimeSecondary", "the module with a secondary constructor")

    let checks = staged.withModule(path, name: "runtime-secondary")
      .artifacts(include: ["runtime-secondary:note/reads-back"]).asChecks
      .{{ pass }}

    if (checks.length != 1) {
      raise "expected the one check behind RuntimeSecondary.note, got " + toString(checks.length)
    }
    # On `pass` rather than on `error.message`: reading the message of a check
    # that passed raises an evaluation error of its own. What it threw is in the
    # trace beside this failure either way.
    if (checks.filter { c => c.pass }.length != 1) {
      raise "the secondary object did not survive the round trip"
    }

    null
  }

  """
  A module should reach the files its source imports when it runs, and when it
  is scanned — with nothing declared.

  Everything else about includes is checked against what generation writes. This
  is the one that runs it, and the fixture exercises both halves of the feature
  at once:

  - `src/index.ts` imports a function from the sibling directory and calls it. A
    module context without those files turns that into a module-resolution
    failure while the dispatcher is still importing the user's source.
  - It reads a file there by a path relative to its own directory, which only
    holds if the module sits at its context subpath under the mount.
  - A @func takes its argument type from that directory, so the scan had to read
    it too — generation resolves the paths from the workspace itself, since the
    `sources` member it would otherwise read is the one it is about to write.

  The fixture declares nothing anywhere: the one import in
  `src/index.ts` is the whole input, and the directory it names is what carries
  `greeting.txt` along with it.

  Read back through a check for the reason entrypointErrorTextCheck gives: a
  check's result is the one thing a caller can read without a typed client.
  """
  includeRunsCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/include/app"
    let generated = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-include", clients: [])
      .withWorkdir(".")

    # The scan resolved `Volume` through the included file: unresolved, the
    # argument would not come out as a plain string.
    let recipe = generated.directory("/" + path).file("entrypoint/main.dang").contents
    if (recipe.contains("withArg(\"prefix\", typeDef.withKind(TypeDefKind.STRING_KIND)") == false) {
      raise "the scan should resolve a @func argument type imported from an included path"
    }
    # Two reads: the sibling the source imports, and the directory that
    # sibling imports in turn — a second hop nothing in the module names.
    if (recipe.contains("workspace.directory(\"..\", include: [\"deeper\", \"shared\"]") == false) {
      raise "the sources member should read the imported directory and the one it imports"
    }

    let installed = generated.withModule(path, name: "runtime-include")

    # `pass` rather than the error message entrypointErrorTextCheck reads: that
    # one's fixture always throws, so its error is never null, and reading
    # `.message` off a passing check's null error fails before the assertion.
    let outcomes = installed.artifacts(include: ["runtime-include:include-check"]).asChecks
      .{{ pass }}
      .map { c => c.pass }

    if (outcomes.length != 1) {
      raise "expected the fixture's one check, got " + toString(outcomes.length)
    }
    if (outcomes.filter { ok => ok == false }.length > 0) {
      raise "a module should reach its declared includes when it runs; the fixture's check failed"
    }

    null
  }

  """
  A Deno module should reach what its import map points at, with nothing
  declared.

  Deno is where derivation has the least to go on: a Deno module has no
  package.json and no tsconfig, so the import map is its only alias mechanism —
  and this fixture imports `@shared/greet`, a bare specifier. Nothing in its
  source names a path outside the module, so the map is the whole input.

  The map names a file, and that is what comes out: a config target is derived
  at the granularity the config wrote it, unlike an import, whose target
  directory is taken because the extension gets rewritten.
  """
  includeDenoRunsCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/include-deno/app"
    let generated = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-include-deno", clients: [])
      .withWorkdir(".")

    let recipe = generated.directory("/" + path).file("entrypoint/main.dang").contents
    # Grouped under the file's own parent, with the file as the include: the
    # map names a file, so that is the granularity, and the parent read is how
    # a file, a directory and a glob are all spelled the same way.
    if (recipe.contains("workspace.directory(\"../shared\", include: [\"greet.ts\"]") == false) {
      raise "the import map target should reach the sources member"
    }
    # And what that target imports, which only following it can find.
    if (recipe.contains("workspace.directory(\"..\", include: [\"deeper\"]") == false) {
      raise "a second hop out of the import map's target should be followed"
    }

    let outcomes = generated.withModule(path, name: "runtime-include-deno")
      .artifacts(include: ["runtime-include-deno:include-check"]).asChecks
      .{{ pass }}
      .map { c => c.pass }

    if (outcomes.length != 1) {
      raise "expected the fixture's one check, got " + toString(outcomes.length)
    }
    if (outcomes.filter { ok => ok == false }.length > 0) {
      raise "a Deno module should reach its import map's target when it runs"
    }

    null
  }

  """
  A call should not be served a result built from an older version of an
  included file.

  Derived from the fixture's import rather than declared, so this also pins that
  a derived path keys a call exactly as a declared one does.

  This is what the engine's `sources` member buys over reading the caller's
  workspace: the engine adds the listed files to the module context *before*
  anything reads the module digest, so they reach the cache key of every
  function call. Read from the workspace instead, as an earlier revision of this
  SDK did, the files are outside everything the key covers — and a function with
  the default cache policy keeps returning its first answer however the files
  change.

  Two loads of the same fixture, with the included file rewritten in between.
  Both calls are in one session, which is the stricter case: a changed digest is
  the only thing that can tell them apart.
  """
  includeCacheKeyCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/include/app"
    let shared = fixtures + "/include/shared/greeting.txt"

    let generated = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-include", clients: [])
      .withWorkdir(".")

    # The fixture's check asserts the file's committed contents, so it passes on
    # the first load and has to fail on the second.
    let first = includeCheckPasses(generated, path)
    let second = includeCheckPasses(generated.withNewFile("/" + shared, "changed\n"), path)

    if (first == false) {
      raise "the fixture's check should pass against the committed included file"
    }
    if (second) {
      raise "a changed included file should give the call a new cache key; the check passed against stale content"
    }

    null
  }

  """
  Whether the include fixture's check passes for a workspace, loaded fresh.
  """
  let includeCheckPasses(ws: Workspace!, path: String!): Boolean! {
    ws.withModule(path, name: "runtime-include")
      .artifacts(include: ["runtime-include:include-check"]).asChecks
      .{{ pass }}
      .map { c => c.pass }
      .filter { ok => ok == false }
      .length == 0
  }

  """
  Generate a fixture, stage the result, and load the module from it.

  Generating into a Workspace rather than writing to disk keeps the generated
  tree out of the fixture entirely — which also sidesteps the trap that a
  module whose .gitignore covers sdk/ hides its own generated files from the
  engine's module context.

  Reading the module's objects is what forces execution: the TypeScript SDK has
  no ModuleTypes function, so type discovery goes through the runtime and the
  committed entrypoint's register().

  Pinned to `legacyRuntime`, which is the path these cover: the three containers
  are the engine's builtin runtime's, one per interpreter, and an entrypoint
  module brings its own recipe instead — a different check, against an engine
  that can load one.
  """
  let assertRuns(ws: Workspace!, runtime: String!, objectName: String!): Void {
    let path = fixtures + "/" + runtime
    assertLoads(generated(ws, path, "runtime-" + runtime), path, objectName, runtime + " module")
  }

  """
  Generate one fixture scope and hand back the workspace carrying the result.

  Pinned to `legacyRuntime` for the reason assertRuns gives, and threaded rather
  than written: a module whose schema depends on another's needs that other one
  generated first, which is what the engine does across scopes and what a check
  generating two of them has to do itself.
  """
  let generated(ws: Workspace!, path: String!, name: String!): Workspace! {
    typescriptSdk(legacyRuntime: true, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: name, clients: [])
      .withWorkdir(".")
  }

  """
  Load a staged module and fail unless it declares the object it should.

  Reading the objects is what forces execution — see assertRuns — so this is
  both "the module loads" and "everything its entrypoint imports evaluated
  without throwing".
  """
  let assertLoads(staged: Workspace!, path: String!, objectName: String!, subject: String!): Void {
    let objects = staged.moduleSource("/" + path).asModule.objects
      .{{ asObject.{{ name }} }}
      .map { o => o.asObject.name }

    if (objects.filter { name => name == objectName }.length == 0) {
      raise subject + " did not load: expected object " + objectName +
        ", got [" + objects.join(", ") + "]"
    }

    null
  }

  """
  A module that reaches a dependency the pre-1.0 way — `dag.<dep>()` rather than
  the dependency's own client — should still run.

  Unified clients moved every module's root fields off the core `dag` and onto a
  client of its own, so migrated source compiles under a type-stripping loader
  and then fails at dispatch with "dag.<dep> is not a function". The compat shim
  puts those fields back, deprecated, and this is the check that the restored
  call survives a real load: the fixture resolves `dag.runtimeDep()` at module
  scope, so a shim that is missing, unimported or broken throws while the
  entrypoint is still importing the user's source, and the module never
  registers its object.

  Two scopes, generated in order: the dependency first, because the dependent's
  schema only loads once the dependency carries its generated files.
  """
  dagDependencyRunsCheck(ws: Workspace!): Void @check {
    let depPath = fixtures + "/dep"
    let appPath = fixtures + "/dag-dep"

    let staged = generated(generated(ws, depPath, "runtime-dep"), appPath, "runtime-dag-dep")

    assertLoads(staged, appPath, "RuntimeDagDep", "the module calling dag.runtimeDep()")
  }

  """
  Fail unless a plain object serialized as an interface was refused by name.
  """
  let assertPlainInterfaceMessage(message: String!): Void {
    if (message.contains("as interface Outputter") == false) {
      raise "a plain object serialized as an interface should fail naming the interface, got: " + message
    }
    if (message.contains("is not a function")) {
      raise "a plain object serialized as an interface should not crash inside the dispatcher, got: " + message
    }

    null
  }

  """
  A function returning an interface should return the engine identity of the
  object implementing it, and say what is missing when there is none.

  An interface value crosses the boundary as the engine ID of the object
  implementing it, so a value from a client carries one and a plain object
  implementing the interface structurally cannot. The dispatcher used to call
  .id() on whatever came back, which crashed the second case with
  "__result.id is not a function" before the function's value was ever
  returned (#90).

  Two scopes, generated in order: the dependency declares the interface and
  returns it, the dependent calls it — a call that stays inside a module never
  reaches the dispatcher, so the dispatcher under test is the dependency's.
  Both outcomes are read off the dependent's own checks, for the reason
  entrypointErrorTextCheck gives.

  Both modules are `[runtime]` ones, which is as far as a staged workspace
  reaches: a module generated into one is only reachable from another through a
  manifest [[dependencies]], an entrypoint manifest has no such table, and an
  entrypoint module reached that way looks its own generated tree up by a path
  it resolves against the caller's workspace — where these fixtures are
  deliberately ungenerated. interfaceFieldEntrypointCheck covers the same
  serialization under an entrypoint.
  """
  interfaceReturnsCheck(ws: Workspace!): Void @check {
    let depPath = fixtures + "/iface-dep"
    let appPath = fixtures + "/iface"

    let installed = generated(generated(ws, depPath, "runtime-iface-dep"), appPath, "runtime-iface")
      .withModule(appPath, name: "runtime-iface")

    let outcomes = installed.artifacts(include: [
      "runtime-iface:from-client-check",
      "runtime-iface:plain-check",
    ]).asChecks.{{ pass, error.{{ message }} }}
    if (outcomes.length != 2) {
      raise "expected the fixture's two checks, got " + toString(outcomes.length)
    }

    # Selected on `pass`, not on the error: a check that passed carries an error
    # with no message in it, and reading that one raises instead of yielding
    # null.
    let messages = outcomes.filter { c => c.pass == false }.map { c => c.error.message }
    if (messages.length != 1) {
      raise "expected only the plain-object check to fail, got " + toString(messages.length) +
        " failures: " + messages.join(" | ")
    }

    assertPlainInterfaceMessage(messages.join(""))
  }

  """
  The same serialization under an entrypoint, where a module reached from
  another is out of a staged workspace's reach.

  What is left is what the engine calls on its own: it dispatches an object's
  constructor before any call on it, so a module whose state carries an
  interface value serializes one without a caller. The fixture's state is a
  plain object, so this is the failing half of interfaceReturnsCheck, running
  through the entrypoint dispatcher and its stdout protocol rather than the
  runtime's.
  """
  interfaceFieldEntrypointCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/iface-field"
    let installed = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-iface-field", clients: [])
      .withWorkdir(".")
      .withModule(path, name: "runtime-iface-field")

    let messages = installed.artifacts(include: ["runtime-iface-field:field-check"]).asChecks
      .{{ pass, error.{{ message }} }}
      .filter { c => c.pass == false }
      .map { c => c.error.message }

    if (messages.length != 1) {
      raise "expected the fixture's one failing check, got " + toString(messages.length)
    }

    assertPlainInterfaceMessage(messages.join(""))
  }

  """
  A module whose config pins a base image should run on that image.

  Under a `[runtime]` the engine reads `dagger.baseImage` and builds on it.
  Under an entrypoint the recipe is ours, and a recipe that kept the SDK's own
  pin ran the module on an image its config did not name, with nothing to say so
  (#91) — a tool the user installed in their image is simply missing.

  The fixture pins a node one major behind the SDK's default and checks the
  interpreter it ends up running on, so this fails if the configured image is
  dropped *and* if an unrelated image is picked up. Its own error names the
  version it saw.
  """
  entrypointBaseImageCheck(ws: Workspace!): Void @check {
    let path = fixtures + "/base-image"
    let installed = typescriptSdk(legacyRuntime: false, skipGenerateFilename: "")
      .generateScope(ws.withWorkdir(path), isModule: true, name: "runtime-base-image", clients: [])
      .withWorkdir(".")
      .withModule(path, name: "runtime-base-image")

    # Only `pass` is selected: on a check that passed, reading `error.message`
    # raises instead of answering null.
    let passes = installed.artifacts(include: ["runtime-base-image:node-major-check"]).asChecks
      .{{ pass }}
      .map { c => c.pass }

    if (passes.length != 1) {
      raise "expected the fixture's one check, got " + toString(passes.length)
    }
    if (passes.filter { p => p }.length != 1) {
      raise "the module ran on an image other than the one its package.json pins"
    }

    null
  }
}
