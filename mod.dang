"""
A Dagger module that uses the TypeScript SDK.
"""
type Mod {
  """
  Workspace-root-relative path of this module root — the directory holding its
  config, and the module's stable identity, independent of where the client is
  invoked from. Discovery and generate address the module by this; the files
  they read and write live under `sourcePath`.
  """
  rootPath: String!

  """
  Workspace containing this module.
  """
  let ws: Workspace!

  """
  This module root relative to the client's current location: "." when the cwd is
  the module itself, "sub/mod" for a module beneath it, ".." for an enclosing one.
  A cwd-relative view of rootPath, so listings read the way a shell user would.
  """
  path: String! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (rootPath == cwd) {
      "."
    } else if (cwd == "") {
      rootPath
    } else if (rootPath.trimPrefix(cwd + "/") != rootPath) {
      rootPath.trimPrefix(cwd + "/")
    } else if (rootPath == "." or cwd.trimPrefix(rootPath + "/") != cwd) {
      let rootDepth = if (rootPath == ".") { 0 } else { rootPath.split("/").length }
      cwd.split("/").dropFirst(rootDepth).map { segment => ".." }.join("/")
    } else {
      rootPath
    }
  }

  """
  Workspace-root-relative path of this module's source directory — where the
  TypeScript runtime reads package.json / deno.json and the module's code from.

  Usually the module root, but a `source` field in the module config points it
  elsewhere: workspace migration writes config to .dagger/modules/<name>/ with
  `source` pointing back at the code (e.g. "../../../ci"), so this is resolved
  through the engine rather than assumed equal to rootPath.
  """
  sourcePath: String! {
    let subpath = ws.moduleSource("/" + rootPath).sourceSubpath
    if (subpath == "" or subpath == ".") { "." } else { subpath }
  }

  """
  Manage this module's TypeScript SDK build configuration (package.json,
  deno.json).
  """
  config: ModConfig! {
    ModConfig(
      sourcePath: sourcePath,
      ws: ws,
    )
  }

  """
  Generate this module's SDK bindings, into its source directory.

  Addresses one module directly, for inspecting or repairing it in isolation.
  The workspace-wide path is `dagger generate`, which the engine drives through
  the SDK's scope generator: it resolves every recorded scope, orders them so a
  module is generated before anything holding a client for it, and threads the
  result through. None of that applies to a single module named by path, so this
  generates exactly the one asked for, against the workspace as it stands.
  """
  generate(ws: Workspace!): Changeset! {
    if (isLegacy(ws)) {
      # A dagger.json module regenerates everything inside its own runtime on
      # every call, so writing generated files here would put a second,
      # differently-versioned copy of them on disk for the runtime to ignore.
      # The engine owns these end to end; this SDK generates the scopes recorded
      # in dagger.toml, and a legacy module cannot be one.
      raise "module is configured by dagger.json, which the engine's runtime generates: " + rootPath
    } else if (hasClients(ws)) {
      # A scope's client targets come from dagger.toml, which only the engine
      # reads; addressing the module by path says nothing about them. Their
      # bindings sit in sdk/ alongside the module's own, and regenerating from
      # the module-facing schema alone would take them away — so stop rather
      # than quietly leave the module unable to resolve its clients.
      raise "module has generated clients; regenerate it with `dagger generate`, which knows what they are: " + rootPath
    } else {
      let sdk = TypescriptSdk()
      let generated = sdk.moduleFiles(
        ws,
        rootPath,
        sourcePath,
        ws.moduleSource("/" + rootPath).moduleOriginalName,
        sdk.effectiveRuntime(ws, sourcePath),
        [],
      )

      generated.changes(ws)
    }
  }

  """
  Whether this module carries a generated client package, and so client bindings
  in sdk/ that only the scope's recorded targets can reproduce.
  """
  let hasClients(ws: Workspace!): Boolean! {
    let dir = if (sourcePath == ".") { "clients" } else { sourcePath + "/clients" }
    ws.directory("/", include: [dir + "/**"]).exists(dir)
  }

  """
  Whether this module uses the legacy dagger.json format. Its counterpart,
  dagger-module.toml, marks a module built from committed generated files — the
  only kind this SDK writes.
  """
  let isLegacy(ws: Workspace!): Boolean! {
    let path = if (rootPath == ".") { "dagger-module.toml" } else { rootPath + "/dagger-module.toml" }
    ws.directory("/", include: [path]).exists(path) == false
  }
}
