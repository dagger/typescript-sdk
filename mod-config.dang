"""
TypeScript SDK build configuration stored in a module's package.json
or deno.json.

Every path resolves against the module's source directory, which is where the
engine reads these files from — not necessarily the directory holding the
module's config.
"""
type ModConfig {
  """
  Workspace-root-relative path of the module's source directory — the directory
  the engine reads these files from, which a `source` field in the module config
  can move away from the module root.
  """
  let sourcePath: String!

  """
  The workspace this module belongs to.
  """
  let ws: Workspace!

  """
  The Node-standard packageManager field (e.g. "pnpm@8.15.4"), read from
  package.json. Empty when unset, or when the module has no package.json.
  """
  packageManager: String! {
    if (runtime == Runtime.DENO) {
      ""
    } else if (hasFile(packageJsonPath)) {
      tool(packageJsonPath).withExec(["module-config", "get-package-manager", toolPath]).stdout
    } else {
      ""
    }
  }

  """
  The package manager this module's dependencies are installed with, as
  `name@version` — or a bare `bun` / `deno`, which ship their own and take no
  pin.

  The same rules the engine's builtin runtime applies (config.go
  detectPackageManager): the runtime's own for Bun and Deno, otherwise
  package.json's `packageManager` field, then whichever lockfile is committed,
  then yarn.

  `rt` is passed in rather than read from `runtime` because the SDK's own
  setting can move a scope onto a runtime its files do not yet imply.
  """
  packageManagerFor(rt: Runtime!): String! {
    if (rt == Runtime.BUN) {
      "bun"
    } else if (rt == Runtime.DENO) {
      "deno"
    } else if (packageManager != "") {
      packageManager
    } else if (runtimeProbe.exists(npmLockPath)) {
      "npm@" + defaultNpmVersion
    } else if (runtimeProbe.exists(pnpmLockPath)) {
      "pnpm@" + defaultPnpmVersion
    } else {
      "yarn@" + defaultYarnVersion
    }
  }

  let packageJsonPath: String! { sourceFile("package.json") }
  let denoJsonPath: String! { sourceFile("deno.json") }
  let bunLockPath: String! { sourceFile("bun.lock") }
  let bunLockbPath: String! { sourceFile("bun.lockb") }
  let npmLockPath: String! { sourceFile("package-lock.json") }
  let pnpmLockPath: String! { sourceFile("pnpm-lock.yaml") }

  """
  Package manager versions a lockfile alone resolves to, matching the engine's
  builtin runtime (config.go). npm's is the one node's own base image ships, so
  a module detected as npm costs no extra install.
  """
  let defaultNpmVersion: String! = "11.8.0"
  let defaultPnpmVersion: String! = "8.15.4"
  let defaultYarnVersion: String! = "1.22.22"

  let sourceFile(name: String!): String! {
    if (sourcePath == ".") { name } else { sourcePath + "/" + name }
  }

  """
  The runtime this module uses, detected from the file layout:
  deno.json -> DENO, bun.lock or bun.lockb -> BUN, otherwise NODE. Mirrors how
  the engine picks the runtime at module load. Both Bun lockfiles are checked:
  newer Bun writes the text bun.lock, but pre-existing modules may still carry
  the binary bun.lockb.
  """
  runtime: Runtime! {
    if (runtimeProbe.exists(denoJsonPath)) {
      if (runtimeProbe.exists(packageJsonPath)) {
        # Contradictory layout: deno.json selects the Deno runtime, but
        # package.json is a Node/Bun config file. The engine can't tell which
        # runtime this module wants, so neither can we — surface it rather than
        # silently treating it as Deno and using the wrong config file.
        raise "module has both deno.json and package.json; a TypeScript SDK module is either Deno (deno.json) or Node/Bun (package.json), not both"
      } else {
        Runtime.DENO
      }
    } else if (runtimeProbe.exists(bunLockPath) or runtimeProbe.exists(bunLockbPath)) {
      Runtime.BUN
    } else {
      Runtime.NODE
    }
  }

  """
  The files runtime and package-manager detection ask about, fetched in one
  pass.

  Probing them through hasFile is one `ws.directory(include: [one file])` call
  each, and each distinct include list is a distinct node in the engine's graph
  — so one filtered directory read per question. Sharing a single include list
  makes it one, and every `exists` after that is a lookup in a directory the
  engine has already materialized.

  Detection runs once per module per generate, so this saves round-trips per
  module rather than once overall.
  """
  let runtimeProbe: Directory! {
    ws.directory("/", include: [
      denoJsonPath,
      packageJsonPath,
      bunLockPath,
      bunLockbPath,
      npmLockPath,
      pnpmLockPath,
    ])
  }

  let toolPath: String! = "/work/config.json"

  let hasFile(file: String!): Boolean! {
    ws.directory("/", include: [file]).exists(file)
  }

  """
  Container with the module-config helper built and the requested config file
  mounted at toolPath.
  """
  let tool(file: String!): Container! {
    let base = TypescriptSdk().moduleConfigBuilder
    if (hasFile(file)) {
      base.withFile(toolPath, ws.directory("/", include: [file]).file(file))
    } else {
      base.withNewFile(toolPath, "{}")
    }
  }
}
